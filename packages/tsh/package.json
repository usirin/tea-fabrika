{
	"name": "@tea-fabrika/tsh",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "A shell for tea programs. The host hands it the list of programs to run.",
	"bin": {
		"tsh": "./bin/tsh"
	},
	"exports": {
		".": "./src/main.ts",
		"./programs": "./src/programs.ts",
		"./small": "./src/small.ts",
		"./launch": "./src/launch.ts",
		"./title": "./src/title.ts",
		"./trace/otel": "./src/trace/otel.ts",
		"./trace/view": "./src/trace/view.ts",
		"./shell": "./src/shell.ts",
		"./short": "./src/short.ts",
		"./builtins": "./src/builtins.ts",
		"./check": "./src/check.ts",
		"./complete": "./src/complete.ts",
		"./decode": "./src/decode.ts",
		"./grammar": "./src/grammar.ts",
		"./jobs": "./src/jobs.ts",
		"./search": "./src/search.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"@effect/opentelemetry": "catalog:",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@tea-fabrika/tea-program": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
