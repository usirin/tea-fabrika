{
	"name": "@kampus/fabrika",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Tools for building your own software factory on tea: programs, a host that runs them on one ledger, a shell, and agents.",
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"!dist/.rsbuild"
	],
	"exports": {
		".": "./src/index.ts",
		"./memory": "./src/host/memory.ts",
		"./sqlite": "./src/host/sqlite.ts",
		"./http": "./src/host/http.ts",
		"./local": "./src/local.ts",
		"./laws": "./src/host/laws.ts",
		"./storage/node": "./src/program/storage-node.ts",
		"./otel": "./src/otel.ts",
		"./shell": "./src/shell.ts",
		"./agents/claude": "./src/agents/claude.ts",
		"./agents/sandbox": "./src/agents/sandbox.ts",
		"./agents/trace": "./src/agents/trace.ts",
		"./agents/acp": "./src/agents/acp.ts",
		"./agents/codex": "./src/agents/codex.ts",
		"./mcp": "./src/mcp.ts",
		"./sandbox/os": "./src/sandbox/os.ts",
		"./spike/serve": "./src/program/spike-serve.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./memory": {
				"types": "./dist/host/memory.d.ts",
				"default": "./dist/host/memory.js"
			},
			"./sqlite": {
				"types": "./dist/host/sqlite.d.ts",
				"default": "./dist/host/sqlite.js"
			},
			"./http": {
				"types": "./dist/host/http.d.ts",
				"default": "./dist/host/http.js"
			},
			"./local": {
				"types": "./dist/local.d.ts",
				"default": "./dist/local.js"
			},
			"./laws": {
				"types": "./dist/host/laws.d.ts",
				"default": "./dist/host/laws.js"
			},
			"./storage/node": {
				"types": "./dist/program/storage-node.d.ts",
				"default": "./dist/program/storage-node.js"
			},
			"./otel": {
				"types": "./dist/otel.d.ts",
				"default": "./dist/otel.js"
			},
			"./shell": {
				"types": "./dist/shell.d.ts",
				"default": "./dist/shell.js"
			},
			"./agents/claude": {
				"types": "./dist/agents/claude.d.ts",
				"default": "./dist/agents/claude.js"
			},
			"./agents/sandbox": {
				"types": "./dist/agents/sandbox.d.ts",
				"default": "./dist/agents/sandbox.js"
			},
			"./agents/trace": {
				"types": "./dist/agents/trace.d.ts",
				"default": "./dist/agents/trace.js"
			},
			"./agents/acp": {
				"types": "./dist/agents/acp.d.ts",
				"default": "./dist/agents/acp.js"
			},
			"./agents/codex": {
				"types": "./dist/agents/codex.d.ts",
				"default": "./dist/agents/codex.js"
			},
			"./mcp": {
				"types": "./dist/mcp.d.ts",
				"default": "./dist/mcp.js"
			},
			"./sandbox/os": {
				"types": "./dist/sandbox/os.d.ts",
				"default": "./dist/sandbox/os.js"
			},
			"./spike/serve": {
				"types": "./dist/program/spike-serve.d.ts",
				"default": "./dist/program/spike-serve.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rslib build",
		"prepack": "node pnpm-only.ts && rslib build",
		"prepublishOnly": "node pnpm-only.ts",
		"typecheck": "tsc --noEmit -p .",
		"check:browser": "node browser-check.ts"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@agentclientprotocol/sdk": "^1.6.1",
		"@anthropic-ai/claude-agent-sdk": "^0.3.296",
		"@anthropic-ai/sandbox-runtime": "0.0.81",
		"@demlik/tea": "^0.21.0",
		"@effect/opentelemetry": "^4.0.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"effect": "^4.0.0",
		"esbuild": "^0.28.2",
		"miniflare": "^4.20260730.0"
	},
	"peerDependenciesMeta": {
		"@agentclientprotocol/sdk": {
			"optional": true
		},
		"@anthropic-ai/claude-agent-sdk": {
			"optional": true
		},
		"@anthropic-ai/sandbox-runtime": {
			"optional": true
		},
		"@effect/opentelemetry": {
			"optional": true
		},
		"@modelcontextprotocol/server": {
			"optional": true
		},
		"@opentelemetry/api": {
			"optional": true
		},
		"@opentelemetry/exporter-trace-otlp-http": {
			"optional": true
		},
		"@opentelemetry/resources": {
			"optional": true
		},
		"@opentelemetry/sdk-trace-base": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"miniflare": {
			"optional": true
		}
	},
	"devDependencies": {
		"@agentclientprotocol/sdk": "catalog:",
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@anthropic-ai/sandbox-runtime": "catalog:",
		"@demlik/tea": "catalog:",
		"@effect/opentelemetry": "catalog:",
		"@effect/vitest": "catalog:",
		"@modelcontextprotocol/client": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@rslib/core": "catalog:",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"fast-check": "catalog:",
		"miniflare": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
