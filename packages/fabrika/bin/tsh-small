#!/bin/sh
# tsh with only its own small programs: say, seq, double, upper, sleep, true,
# false, tally. A dev script, run from the source: `@kampus/fabrika-old` installs
# no command. An app that lists more programs ships its own bin, as
# `@kampus/pipeline` does with `tsh`.
here=$(cd "$(dirname "$0")" && pwd)
exec node --disable-warning=ExperimentalWarning "$here/../src/shell/bin.ts" "$@"
