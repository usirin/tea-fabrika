#!/bin/sh
# tsh: a shell for tea programs, with fabrika's programs listed. It runs src/tsh.ts from the
# source. The installed package's bin is the build of that file. See experiments/67-tsh.md.
here=$(cd "$(dirname "$0")" && pwd)
exec node --disable-warning=ExperimentalWarning "$here/../src/tsh.ts" "$@"
