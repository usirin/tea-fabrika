#!/bin/sh
# tsh with only its own small programs: say, seq, double, upper, sleep, true,
# false, tally. `@kampus/fabrika`'s bin, run from the source. An app that
# lists more programs ships its own launcher, as `@kampus/pipeline` does.
here=$(cd "$(dirname "$0")" && pwd)
exec node --disable-warning=ExperimentalWarning "$here/../src/shell/bin.ts" "$@"
