{
	"name": "@kampus/ledger-server",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "One project's ledger server: the ledger's Worker and its Durable Object, declared with Alchemy for Cloudflare, and its local twin in Miniflare from the same entry and the same bindings.",
	"engines": {
		"node": ">=26"
	},
	"exports": {
		"./*": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"twin": "node src/twin-main.ts"
	},
	"dependencies": {
		"@alchemy.run/cloudflare": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/fabrika-old": "workspace:*",
		"alchemy": "catalog:",
		"effect": "catalog:",
		"esbuild": "catalog:",
		"miniflare": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
