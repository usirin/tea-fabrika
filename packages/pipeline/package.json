{
	"name": "@kampus/pipeline",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The work pipeline, an app on @kampus/fabrika: its stages, the programs it lists in tsh, and the bin that runs them. The name is a placeholder.",
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"!dist/.rsbuild",
		"rubrics"
	],
	"bin": {
		"tsh": "./bin/tsh"
	},
	"exports": {
		"./*": "./src/*.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"bin": {
			"tsh": "./dist/tsh.js"
		},
		"exports": {
			"./*": {
				"types": "./dist/*.d.ts",
				"default": "./dist/*.js"
			},
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "rslib build",
		"prepack": "node ../fabrika/pnpm-only.ts && rslib build",
		"prepublishOnly": "node ../fabrika/pnpm-only.ts",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@kampus/fabrika": "workspace:*",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"@agentclientprotocol/sdk": "^1.6.1",
		"@anthropic-ai/claude-agent-sdk": "^0.3.296",
		"@demlik/tea": "^0.21.0",
		"@effect/opentelemetry": "^4.0.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-trace-base": "^2.11.0",
		"effect": "^4.0.0",
		"miniflare": "^4.20260730.0"
	},
	"peerDependenciesMeta": {
		"@agentclientprotocol/sdk": {
			"optional": true
		},
		"@anthropic-ai/claude-agent-sdk": {
			"optional": true
		},
		"@effect/opentelemetry": {
			"optional": true
		},
		"@opentelemetry/api": {
			"optional": true
		},
		"@opentelemetry/exporter-trace-otlp-http": {
			"optional": true
		},
		"@opentelemetry/resources": {
			"optional": true
		},
		"@opentelemetry/sdk-trace-base": {
			"optional": true
		},
		"miniflare": {
			"optional": true
		}
	},
	"devDependencies": {
		"@agentclientprotocol/sdk": "catalog:",
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@demlik/tea": "catalog:",
		"@effect/opentelemetry": "catalog:",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@rslib/core": "catalog:",
		"@types/node": "catalog:",
		"effect": "catalog:",
		"miniflare": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
