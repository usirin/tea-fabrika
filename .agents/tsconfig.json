    "skills/lead/scripts/chain.ts",
    "skills/lead/scripts/chain.test.ts",
    "skills/lead/scripts/clauderow.ts",
    "skills/lead/scripts/clauderow.test.ts",
    "skills/lead/scripts/drive.ts",
    "skills/lead/scripts/drive.test.ts",
    "skills/lead/scripts/gc.ts",
    "skills/lead/scripts/gc.test.ts",
    "skills/lead/scripts/lanes.ts",
    "skills/lead/scripts/lanes.test.ts",
    "skills/lead/scripts/mutbox.ts",
    "skills/lead/scripts/mutbox.test.ts",
    "skills/lead/scripts/flow/*.ts",
    "skills/lead/scripts/flow/flows/*.ts",
    "skills/mutation/scripts/heartbeat.ts",
