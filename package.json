{
	"name": "tea-fabrika",
	"private": true,
	"type": "module",
	"description": "Fabrika as a tea machine: a minimal repro",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"demo": "node src/demo.ts",
		"demo:claude": "AGENT=claude node src/demo.ts",
		"demo:hard": "TOY=duration AGENT=claude node src/demo.ts",
		"real": "node src/real.ts",
		"tsh": "node src/tsh/fabrika-main.ts",
		"trace:up": "docker run -d --rm --name tsh-jaeger --user 0 -p 16686:16686 -p 4318:4318 -v tsh-jaeger-data:/badger -v \"$PWD/jaeger:/etc/jaeger:ro\" -e OTEL_TRACES_SAMPLER=always_off jaegertracing/jaeger:2.21.0 --config /etc/jaeger/config.yaml && echo 'Jaeger: http://localhost:16686'",
		"trace:down": "docker stop tsh-jaeger",
		"trace:wipe": "docker volume rm tsh-jaeger-data"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "catalog:",
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@demlik/code-graph": "catalog:",
		"@demlik/tea": "catalog:",
		"@effect/opentelemetry": "catalog:",
		"@effect/platform-node": "catalog:",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"effect": "catalog:",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
