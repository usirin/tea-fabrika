{
	"name": "tea-fabrika",
	"private": true,
	"type": "module",
	"description": "Fabrika as a tea machine: a minimal repro",
	"scripts": {
		"prepare": "effect-tsgo patch --typescript",
		"typecheck": "effect-tsgo patch --typescript && pnpm -r typecheck",
		"build": "pnpm --filter @kampus/fabrika --filter @kampus/pipeline build",
		"test": "vitest run",
		"lint": "biome check --error-on-warnings . && pnpm -s lint:layers && pnpm -s lint:boundaries && pnpm -s lint:dead && pnpm -s lint:size && pnpm -s lint:browser",
		"lint:layers": "code-graph . --layers --layer-rules layer-rules.json",
		"lint:boundaries": "code-graph . --boundaries --ci --boundary-rules boundary-rules.json",
		"lint:dead": "code-graph . --unreachable --ci",
		"lint:size": "code-graph . --ci",
		"lint:browser": "node packages/fabrika/browser-check.ts",
		"promises": "node packages/promises/src/main.ts",
		"format": "biome check --write .",
		"demo": "node legacy/src/demo.ts",
		"demo:claude": "AGENT=claude node legacy/src/demo.ts",
		"demo:hard": "TOY=duration AGENT=claude node legacy/src/demo.ts",
		"real": "node legacy/src/real.ts",
		"tsh": "node packages/pipeline/src/tsh/fabrika-main.ts",
		"trace:up": "docker run -d --rm --name tsh-jaeger --user 0 -p 16686:16686 -p 4318:4318 -v tsh-jaeger-data:/badger -v \"$PWD/jaeger:/etc/jaeger:ro\" -e OTEL_TRACES_SAMPLER=always_off jaegertracing/jaeger:2.21.0 --config /etc/jaeger/config.yaml && echo 'Jaeger: http://localhost:16686'",
		"trace:down": "docker stop tsh-jaeger",
		"trace:wipe": "docker volume rm tsh-jaeger-data"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "catalog:",
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@demlik/code-graph": "catalog:",
		"@demlik/tea": "catalog:",
		"@effect/opentelemetry": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/fabrika": "workspace:*",
		"@kampus/pipeline": "workspace:*",
		"@kampus/promises": "workspace:*",
		"@opentelemetry/api": "catalog:",
		"@opentelemetry/exporter-trace-otlp-http": "catalog:",
		"@opentelemetry/resources": "catalog:",
		"@opentelemetry/sdk-trace-base": "catalog:",
		"@tea-fabrika/ask-log": "workspace:*",
		"@tea-fabrika/owner-desk": "workspace:*",
		"@tea-fabrika/ui-verification": "workspace:*",
		"effect": "catalog:",
		"smol-toml": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@demlik/structure-sweep": "catalog:",
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"miniflare": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"packageManager": "pnpm@10.27.0",
	"volta": {
		"node": "26.12.0"
	}
}
