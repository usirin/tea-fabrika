// A Claude run loads a project's settings only through `ownRules`
// (packages/fabrika/src/agents/claude/rules.ts): `settingSources: ["project"]`
// for the rule files, with `projectConfigRoot` on the system's empty folder.
//
// Why: `settingSources: ["project"]` alone also loads the project's
// `.claude/settings.json`. In experiment 155 that ran the project's hooks
// outside the sandbox, handed its env to the agent and to Claude Code, and ran
// its `apiKeyHelper`. Agents write the repository too, so a hook added by
// mistake, or by text injected into an agent, would run on the next agent's run.
// The owner's ruling of 2026-10-26 keeps that out even where only trusted people
// work (docs/direction/agents-read-rules-the-normal-way.md).
//
// So, anywhere but rules.ts and tests (biome.jsonc's override leaves those
// out: a test writes the options' shape to check it, and starts no live run),
// this refuses:
//   - an object's `settingSources` whose value is anything but `[]`, and the
//     shorthand `{settingSources}`;
//   - an object's `projectConfigRoot`, whatever its value, so nothing points it
//     at another folder after `...ownRules(...)`;
//   - the same two set by assignment (`options.settingSources = ...`);
//   - the CLI's own flags: `"--setting-sources"` followed by anything but `""`
//     in a list of arguments, `"--setting-sources=<some>"`, and any
//     `--project-config-root`, also as an `extraArgs` key.
//
// What it cannot see: options that leave `settingSources` out, which makes the
// Agent SDK load every settings file. A live run's own check refuses those
// (`startRefusal`, rules.ts). A run that loads the project's settings on
// purpose (an experiment that measures them, the old operator) carries
// `// biome-ignore lint/plugin/no-project-settings: <why>`.
//
// This repo's own rule, not a copy from phoenix. It blocks. When it was added
// it fired 17 times: 12 on runs that load the project's settings on purpose
// (experiment 155's variants, experiment 43's spike, the old operator in
// legacy/), each now carrying its reason; 4 in tests that write the options'
// shape, which is why tests are left out; and 1 on experiment 127's
// `settingSources: ["project"]`. That line was safe only because a spread
// beside it already held the empty folder, so 127 no longer loaded the
// project hook it measures. It now drops the folder on purpose and says so.
// Each of the 13 fires outside tests led to a change or a written reason.
language js;

or {
	JsPropertyObjectMember(name = $name, value = $value) where {
		$name <: or { r"^settingSources$", r"^\"settingSources\"$", r"^'settingSources'$" },
		not $value <: `[]`,
		register_diagnostic(
			span = $name,
			message = "`settingSources` with a source in it can load the project's hooks, env and apiKeyHelper (experiment 155). Load a folder's rule files with `...ownRules(...)` from @kampus/fabrika/agents/sandbox, or no settings with `settingSources: []`. On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	JsPropertyObjectMember(name = $name) where {
		$name <: or { r"^projectConfigRoot$", r"^\"projectConfigRoot\"$", r"^'projectConfigRoot'$" },
		register_diagnostic(
			span = $name,
			message = "`projectConfigRoot` is set only by `ownRules` (@kampus/fabrika/agents/sandbox), on the system's empty folder: pointed anywhere else, a run reads that folder's settings and hooks (experiment 155). On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	JsShorthandPropertyObjectMember() as $member where {
		$member <: or { r"^settingSources$", r"^projectConfigRoot$" },
		register_diagnostic(
			span = $member,
			message = "Where a Claude run's settings come from is said only by `ownRules` (@kampus/fabrika/agents/sandbox), or `settingSources: []`, written out. On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	`$options.settingSources = $value` as $set where {
		not $value <: `[]`,
		register_diagnostic(
			span = $set,
			message = "`settingSources` with a source in it can load the project's hooks, env and apiKeyHelper (experiment 155). Use `...ownRules(...)` from @kampus/fabrika/agents/sandbox, or `settingSources: []`. On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	`$options.projectConfigRoot = $value` as $set where {
		register_diagnostic(
			span = $set,
			message = "`projectConfigRoot` is set only by `ownRules` (@kampus/fabrika/agents/sandbox), on the system's empty folder (experiment 155). On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	JsArrayExpression(elements = [..., `"--setting-sources"` as $flag, $value, ...]) where {
		not $value <: `""`,
		register_diagnostic(
			span = $flag,
			message = "`--setting-sources` with a source in it can load the project's hooks, env and apiKeyHelper (experiment 155). Pass an empty string, or run through the Agent SDK with `...ownRules(...)`. On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	JsStringLiteralExpression() as $flag where {
		$flag <: or { r"^\"--project-config-root.*", r"^'--project-config-root.*", r"^\"--setting-sources=.+", r"^'--setting-sources=.+" },
		register_diagnostic(
			span = $flag,
			message = "Where a Claude run's settings come from is said only by `ownRules` (@kampus/fabrika/agents/sandbox), not by a CLI flag (experiment 155). On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	},
	JsPropertyObjectMember(name = $name, value = $value) where {
		$name <: or { r"^\"setting-sources\"$", r"^'setting-sources'$", r"^\"project-config-root\"$", r"^'project-config-root'$" },
		not $value <: `""`,
		register_diagnostic(
			span = $name,
			message = "Where a Claude run's settings come from is said only by `ownRules` (@kampus/fabrika/agents/sandbox), not by `extraArgs` (experiment 155). On purpose: // biome-ignore lint/plugin/no-project-settings: <why>.",
			severity = "error"
		)
	}
}
