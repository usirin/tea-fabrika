+	/**
+	 * Experiment 143: local echo, as mosh predicts it. One printable character typed with the
+	 * cursor at the end of tsh's prompt line is drawn at once, before tsh answers. tsh's own redraw
+	 * of the line comes after, and writes the same cells over it. Anywhere else, nothing is guessed.
+	 */
+	const echoes = (data: string) => {
+		if (data.length !== 1 || data < " " || data > "~") return false;
+		const buffer = term.buffer.active;
+		const x = buffer.cursorX;
+		const row =
+			buffer.getLine(buffer.length - term.rows + buffer.cursorY)?.translateToString(true) ?? "";
+		return row.startsWith("tsh$") && x >= row.length && x < term.cols - 1;
+	};
 	const size = (cols: number, rows: number) =>
 		window.fabrika.send(port, {type: "size", cols: cells(cols), rows: cells(rows)});
 
