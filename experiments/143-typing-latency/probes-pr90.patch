diff -ruN a/apps/fabrika/src/probe-net.ts b/apps/fabrika/src/probe-net.ts
--- a/apps/fabrika/src/probe-net.ts
+++ b/apps/fabrika/src/probe-net.ts
@@ -0,0 +1,37 @@
+import {writeFileSync} from "node:fs";
+import {Socket} from "node:net";
+import {probe, probes} from "./probe.ts";
+
+// Experiment 143: the host's socket, timed where the bytes meet the kernel. Only chunks that
+// carry the timed tile's keys or its screen are timed: `up` names what this side writes, and
+// `down` what it reads, as {"type":"keys"} or {"type":"write"} on that tile's port.
+
+export const timeSocket = (side: "app" | "host") => {
+	const wrote = side === "app" ? '"keys"' : '"write"';
+	const read = side === "app" ? '"write"' : '"keys"';
+	// Searched as bytes, in place, not copied into text: a busy tile sends many chunks.
+	const has = (chunk: unknown, text: string) =>
+		typeof chunk === "string"
+			? chunk.includes(text)
+			: chunk instanceof Uint8Array &&
+				Buffer.from(chunk.buffer, chunk.byteOffset, chunk.byteLength).includes(text);
+	const ours = (chunk: unknown, what: string) =>
+		has(chunk, `"tile:${probes.tile}"`) && has(chunk, what);
+	const write = Socket.prototype.write;
+	Socket.prototype.write = function (this: Socket, ...args: unknown[]) {
+		if (ours(args[0], wrote)) probe("sock-write");
+		return (write as (...a: unknown[]) => boolean).apply(this, args);
+	} as typeof write;
+	const emit = Socket.prototype.emit;
+	Socket.prototype.emit = function (this: Socket, event: string | symbol, ...args: unknown[]) {
+		if (event === "data" && ours(args[0], read)) probe("sock-data");
+		return emit.call(this, event, ...args);
+	} as typeof emit;
+};
+
+/** The host's rows, written to a file on SIGUSR2: the script reads them there. */
+export const dumpOn = (file: string) =>
+	process.on("SIGUSR2", () => {
+		writeFileSync(file, JSON.stringify(probes.rows));
+		probes.rows.length = 0;
+	});
diff -ruN a/apps/fabrika/src/probe.ts b/apps/fabrika/src/probe.ts
--- a/apps/fabrika/src/probe.ts
+++ b/apps/fabrika/src/probe.ts
@@ -0,0 +1,27 @@
+// Experiment 143's timing probes, in a copy of the app only: never in the app itself. Each
+// process keeps its own list, on its own clock (performance.now), and the script reads each list
+// and takes differences inside it. Nothing here crosses a process.
+//
+//   probe("in", "keys")       a row: its name, the time, and what it was about
+//   probes.tile = "t2"        the tile whose keys and screen are timed; the others are not
+//   probes.after = (name) =>  called after each row: the script waits on "frame" with it
+
+interface Probes {
+	readonly rows: unknown[][];
+	/** The tile timed. */
+	tile: string;
+	after?: (name: string) => void;
+}
+
+const held = globalThis as unknown as {__x143?: Probes};
+export const probes: Probes = held.__x143 ?? {rows: [], tile: "t1"};
+held.__x143 = probes;
+
+/** One row: what happened, when, and a small note. */
+export const probe = (name: string, note?: unknown) => {
+	probes.rows.push(note === undefined ? [name, performance.now()] : [name, performance.now(), note]);
+	probes.after?.(name);
+};
+
+/** Is this port the timed tile's? */
+export const timed = (port: string) => port === `tile:${probes.tile}`;
