+import type {Open} from "../desk/desk.ts";
+import {activeOf} from "../desk/desk.ts";
+import {isFolded, type LayoutNode, type TileId, type TileNode, tiles} from "../desk/layout/index.ts";
+
+// The layers study's designs, built side by side in today's app for step 5 of the guidelines
+// study (experiment 207). A lab branch, never merged. Which one draws is the page's setting
+// `fabrika.layers` in localStorage: today (main's behavior), d1, d2, d3 or d4.
+//
+//   d1  one over, today's rule kept: the desk is inert under the palette, and the bottom line names
+//       the layer that takes the keys. Enter on an ask turns the ticket tile and focuses it.
+//   d2  floats, tmux 3.8's way: a ticket's tile floats over the workspace (206's place = "float").
+//   d3  sheets: the answer opens as a sheet over the ticket's tile only, modal to that tile.
+//   d4  a peek unfolds in place: the ticket's tile waits as a strip; Space in the asks menu opens
+//       it in place without moving focus; the arrows follow; Esc folds it back.
+
+export type Design = "today" | "d1" | "d2" | "d3" | "d4";
+
+const DESIGNS: readonly Design[] = ["today", "d1", "d2", "d3", "d4"];
+
+const read = (): Design => {
+	try {
+		const said = localStorage.getItem("fabrika.layers");
+		return DESIGNS.find((d) => d === said) ?? "today";
+	} catch {
+		return "today";
+	}
+};
+
+export const DESIGN: Design = read();
+
+/** A tile of the active workspace whose run is the ticket program, and that run. */
+export interface TicketTile {
+	readonly tile: TileNode;
+	readonly run: string;
+}
+
+export const ticketTileOf = (desk: Open): TicketTile | undefined => {
+	const ws = activeOf(desk);
+	for (const tile of tiles(ws.layout.root)) {
+		const run = tile.shows.run;
+		if (run != null && run.program === "ticket") return {tile, run: run.id};
+	}
+	return undefined;
+};
+
+/** Is this node, or a tile under it, folded into a strip. */
+export const foldedTile = (node: LayoutNode): boolean => isFolded(node);
+
+/** d2: the tile that floats over the workspace, in the active workspace, if any. */
+export const floatOf = (desk: Open): TileId | null =>
+	DESIGN === "d2" ? (ticketTileOf(desk)?.tile.id ?? null) : null;
+
+// d3: the sheet. One per tile at most, said here so the frame's bottom line can name it, and a
+// ticket's window opens it when it draws the ticket asked for.
+
+export interface Sheet {
+	/** The ticket whose ask the sheet answers. */
+	readonly ticket: number;
+	/** Open now (drawn), or asked for and waiting for the ticket's window to draw it. */
+	readonly open: boolean;
+}
+
+const SHEET_EVENT = "fabrika-sheet";
+
+declare global {
+	interface Window {
+		fabrikaSheet?: Sheet | null;
+	}
+}
+
+export const sheetNow = (): Sheet | null => window.fabrikaSheet ?? null;
+
+export const setSheet = (sheet: Sheet | null) => {
+	window.fabrikaSheet = sheet;
+	window.dispatchEvent(new Event(SHEET_EVENT));
+};
+
+export const onSheet = (listener: () => void) => {
+	window.addEventListener(SHEET_EVENT, listener);
+	return () => window.removeEventListener(SHEET_EVENT, listener);
+};
