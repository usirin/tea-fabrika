+
+/* ---------------------------------------------------------------- layers study, a lab branch */
+
+/* Every design: the workspace holds its own layers (d2's float). */
+.workspace {
+	position: relative;
+}
+
+/* d2: a float, tmux 3.8's floating pane: a tile placed over the workspace, under every popover. */
+.float-layer {
+	position: absolute;
+	z-index: 5;
+	top: var(--s-6);
+	right: var(--s-6);
+	bottom: var(--s-6);
+	width: min(56%, 760px);
+	display: flex;
+	border-radius: var(--r-lg);
+	box-shadow: var(--pop-shadow);
+}
+
+.float-word {
+	color: var(--text-faint);
+}
+
+/* d3: a sheet over one tile's view, as a macOS sheet hangs from its window's title bar. */
+main.program:has(.sheet-layer) > * {
+	position: static;
+}
+
+.sheet-layer {
+	position: absolute;
+	z-index: 4;
+	inset: 0;
+	display: flex;
+	justify-content: center;
+	align-items: flex-start;
+	background: var(--scrim);
+}
+
+.sheet {
+	box-sizing: border-box;
+	width: min(520px, calc(100% - 2 * var(--s-3)));
+	max-height: calc(100% - var(--s-3));
+	overflow: auto;
+	display: grid;
+	gap: var(--s-2);
+	padding: var(--s-3) var(--s-4) var(--s-4);
+	border: 1px solid var(--pop-edge);
+	border-top: 0;
+	border-radius: 0 0 var(--r-lg) var(--r-lg);
+	background: var(--pop-bg);
+	box-shadow: var(--pop-shadow);
+}
+
+.sheet .sheet-title {
+	color: var(--text-primary);
+	font-weight: 500;
+}
+
+.sheet .sheet-label {
+	font-size: var(--fs-small);
+	color: var(--text-muted);
+	margin-top: var(--s-1);
+}
+
+.sheet .sheet-acts {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--s-2);
+}
+
+.sheet .sheet-gap {
+	flex: 1;
+}
