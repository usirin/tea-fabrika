  {
    "toy": "slugify",
    "run": 2,
    "criteria": [
      {
        "id": "output-is-url-safe",
        "rule": "slugify returns a string made only of characters that can appear in a URL path without escaping (letters, digits, '-', '.', '_', '~').",
        "examples": [
          {
            "call": "/^[A-Za-z0-9._~-]*$/.test(slugify(\"Hello World!\"))",
            "result": "true"
          }
        ],
        "no_example": null,
        "checked": [
          {
            "call": "/^[A-Za-z0-9._~-]*$/.test(slugify(\"Hello World!\"))",
            "result": "true",
            "runnable": true,
            "wrong": false,
            "actual": null,
            "empty": false
          }
        ]
      },
      {
        "id": "title-not-returned-unchanged",
        "rule": "slugify does not return a title containing unsafe URL characters unchanged.",
        "examples": [
          {
            "call": "slugify(\"Hello World!\") !== \"Hello World!\"",
            "result": "true"
          }
        ],
        "no_example": null,
        "checked": [
          {
            "call": "slugify(\"Hello World!\") !== \"Hello World!\"",
            "result": "true",
            "runnable": true,
            "wrong": false,
            "actual": null,
            "empty": false
          }
        ]
      },
      {
        "id": "keeps-title-words",
        "rule": "The slug still contains the words of the title, so it is not just an empty or unrelated string.",
