  {
    "toy": "slugify",
    "run": 0,
    "criteria": [
      {
        "id": "slug-needs-no-url-escaping",
        "rule": "The string slugify returns can be put in a URL as-is: percent-encoding it with encodeURIComponent leaves it unchanged.",
        "examples": [
          {
            "call": "((s) => encodeURIComponent(s) === s)(slugify(\"Slugs look wrong? Yes/no & more\"))",
            "result": "true"
          }
        ],
        "no_example": null,
        "checked": [
          {
            "call": "((s) => encodeURIComponent(s) === s)(slugify(\"Slugs look wrong? Yes/no & more\"))",
            "result": "true",
            "runnable": true,
            "wrong": false,
            "actual": null,
            "empty": false
          }
        ]
      },
      {
        "id": "title-words-kept-in-order",
        "rule": "The slug keeps the words of the title in their original order, ignoring letter case.",
        "examples": [
          {
            "call": "/hello.*world/i.test(slugify(\"Hello World\"))",
            "result": "true"
          }
        ],
        "no_example": null,
        "checked": [
