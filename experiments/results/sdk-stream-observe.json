        "patch": [
          "-// The issue asks for parseDuration(text). This is the starting point: it does nothing yet.",
          "+// Parses durations like \"1h30m15s\" (units: d, h, m, s) into seconds; null if invalid.",
          " export function parseDuration(text) {",
          "-  return null;",
          "+  if (typeof text !== \"string\") return null;",
          "+  const s = text.trim();",
          "+  const m = /^(?:(\\d+)d)?(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$/.exec(s);",
          "+  if (!s || !m) return null;",
          "+  const [d, h, min, sec] = m.slice(1).map((v) => Number(v || 0));",
          "+  return d * 86400 + h * 3600 + min * 60 + sec;",
          " }"
        ]
      }
