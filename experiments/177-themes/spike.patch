diff --git a/apps/fabrika/src/window/theme.ts b/apps/fabrika/src/window/theme.ts
new file mode 100644
index 0000000..297e24a
--- /dev/null
+++ b/apps/fabrika/src/window/theme.ts
@@ -0,0 +1,277 @@
+import {Schema} from "effect";
+
+// SPIKE for experiment 177, today's version. Not for main.
+//
+// A theme is the viewer's choice, and only data: names and hex colors. The page decodes it here,
+// works out the app's tokens from it in code, moves any text too faint to read, and sets the
+// tokens through the CSS object model. No CSS text is ever built from a theme.
+//
+//   const read = decodeTheme(raw);        // refused unless every color is a #rrggbb
+//   const made = tokensOf(read);          // {tokens: {"--n-1": "#11111b", ...}, moved: [...]}
+//   applyTheme(read);                     // one task: the page and every terminal, then a frame
+//   applyTheme(null);                     // the app's own look again
+
+/** A color, and nothing that is not one. No `url()`, no `var()`, no name. */
+const Hex = Schema.String.check(Schema.isPattern(/^#[0-9a-f]{6}$/));
+const Six = Schema.Tuple([Hex, Hex, Hex, Hex, Hex, Hex]);
+const Sixteen = Schema.Tuple([
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+	Hex,
+]);
+
+const Terminal = Schema.Struct({
+	foreground: Hex,
+	background: Hex,
+	cursor: Hex,
+	selectionBackground: Hex,
+	selectionForeground: Hex,
+	palette: Sixteen,
+});
+
+export const Theme = Schema.Struct({
+	format: Schema.Literal(1),
+	name: Schema.String.check(Schema.isPattern(/^[\p{L}\p{N} ._-]{1,60}$/u)),
+	by: Schema.String.check(Schema.isMaxLength(200)),
+	look: Schema.Literals(["dark", "light"]),
+	/** Where it came from: a format fabrika did not invent, and the hash of the file as read. */
+	from: Schema.Struct({
+		format: Schema.Literals(["base16", "base24", "ghostty", "fabrika"]),
+		hash: Schema.String.check(Schema.isPattern(/^sha256-[0-9a-f]{64}$/)),
+	}),
+	ground: Hex,
+	ink: Hex,
+	turn: Hex,
+	done: Hex,
+	running: Hex,
+	stuck: Hex,
+	lines: Six,
+	services: Six,
+	/** How much of a line's color goes into its tiles, in percent. */
+	tint: Schema.Int.check(Schema.isBetween({minimum: 0, maximum: 100})),
+	terminal: Terminal,
+});
+export type Theme = typeof Theme.Type;
+export type TerminalColors = typeof Terminal.Type;
+
+export const decodeTheme = Schema.decodeUnknownSync(Theme, {onExcessProperty: "error"});
+
+// Color math. OKLCH, the space the app's own palette is written in.
+
+interface Lch {
+	readonly l: number;
+	readonly c: number;
+	readonly h: number;
+}
+
+const toLinear = (u: number) => (u <= 0.04045 ? u / 12.92 : ((u + 0.055) / 1.055) ** 2.4);
+const fromLinear = (u: number) => (u <= 0.0031308 ? 12.92 * u : 1.055 * u ** (1 / 2.4) - 0.055);
+
+const rgbOf = (hex: string): readonly [number, number, number] => [
+	Number.parseInt(hex.slice(1, 3), 16) / 255,
+	Number.parseInt(hex.slice(3, 5), 16) / 255,
+	Number.parseInt(hex.slice(5, 7), 16) / 255,
+];
+
+const linearOf = (hex: string): readonly [number, number, number] => {
+	const [r, g, b] = rgbOf(hex);
+	return [toLinear(r), toLinear(g), toLinear(b)];
+};
+
+const lchOf = (hex: string): Lch => {
+	const [r, g, b] = linearOf(hex);
+	const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
+	const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
+	const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
+	const L = 0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s;
+	const A = 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s;
+	const B = 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s;
+	return {l: L, c: Math.hypot(A, B), h: Math.atan2(B, A)};
+};
+
+const rgbFrom = ({l: L, c, h}: Lch): readonly [number, number, number] => {
+	const A = c * Math.cos(h);
+	const B = c * Math.sin(h);
+	const l = (L + 0.3963377774 * A + 0.2158037573 * B) ** 3;
+	const m = (L - 0.1055613458 * A - 0.0638541728 * B) ** 3;
+	const s = (L - 0.0894841775 * A - 1.291485548 * B) ** 3;
+	return [
+		4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+		-1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+		-0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
+	];
+};
+
+const hexFrom = (lch: Lch): string => {
+	// Out of the screen's colors, chroma gives way and lightness and hue stay.
+	let c = lch.c;
+	let rgb = rgbFrom({...lch, c});
+	while (c > 0 && rgb.some((u) => u < -0.0005 || u > 1.0005)) {
+		c = Math.max(0, c - 0.002);
+		rgb = rgbFrom({...lch, c});
+	}
+	const part = (u: number) =>
+		Math.round(Math.min(1, Math.max(0, fromLinear(Math.max(0, u)))) * 255)
+			.toString(16)
+			.padStart(2, "0");
+	return `#${rgb.map(part).join("")}`;
+};
+
+const mix = (from: string, to: string, t: number): string => {
+	const a = lchOf(from);
+	const b = lchOf(to);
+	const turnBy = Math.atan2(Math.sin(b.h - a.h), Math.cos(b.h - a.h));
+	return hexFrom({
+		l: Math.min(1, Math.max(0, a.l + (b.l - a.l) * t)),
+		c: Math.max(0, a.c + (b.c - a.c) * t),
+		h: a.h + turnBy * t,
+	});
+};
+
+/** WCAG's contrast ratio of two colors. */
+export const contrast = (a: string, b: string): number => {
+	const lum = (hex: string) => {
+		const [r, g, bl] = linearOf(hex);
+		return 0.2126 * r + 0.7152 * g + 0.0722 * bl;
+	};
+	const [x, y] = [lum(a), lum(b)];
+	return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);
+};
+
+/**
+ * The ink moved along its own hue until it reads on `ground`, as iTerm2's minimum contrast moves
+ * text and never the background. It goes away from the ground first; if that side runs out, the
+ * other way.
+ */
+const readable = (ink: string, ground: string, least: number): string => {
+	if (contrast(ink, ground) >= least) return ink;
+	const lch = lchOf(ink);
+	const away = lchOf(ground).l > 0.6 ? -1 : 1;
+	for (const way of [away, -away]) {
+		for (let l = lch.l; l >= 0 && l <= 1; l += way * 0.005) {
+			const tried = hexFrom({...lch, l});
+			if (contrast(tried, ground) >= least) return tried;
+		}
+	}
+	return contrast("#000000", ground) > contrast("#ffffff", ground) ? "#000000" : "#ffffff";
+};
+
+/** Where the app's own 12 grays sit between its ground (--n-2) and its first ink (--n-12). */
+const RAMP = [-0.037, 0, 0.035, 0.071, 0.102, 0.134, 0.189, 0.29, 0.587, 0.679, 0.803, 1];
+
+/** Every token a theme sets: the names in window.css's :root that hold a color. */
+export const tokensOf = (theme: Theme) => {
+	const moved: {token: string; was: string; now: string; ratio: number}[] = [];
+	const {ground, ink, look} = theme;
+	const inkRead = readable(ink, ground, 7);
+	const tokens: Record<string, string> = {};
+	RAMP.forEach((t, i) => {
+		tokens[`--n-${i + 1}`] = mix(ground, inkRead, t);
+	});
+	if (look === "light") {
+		// A light theme's sunken ground is darker, and what is raised is lighter than the ground.
+		tokens["--n-1"] = mix(ground, inkRead, 0.05);
+		tokens["--n-3"] = mix(ground, "#ffffff", 0.5);
+	}
+	const text = (token: string, least: number) => {
+		const was = tokens[token] ?? ink;
+		const raised = tokens["--n-3"] ?? ground;
+		const worse = contrast(was, raised) < contrast(was, ground) ? raised : ground;
+		const now = readable(was, worse, least);
+		if (now !== was) moved.push({token, was, now, ratio: contrast(was, worse)});
+		tokens[token] = now;
+	};
+	for (const token of ["--n-9", "--n-10", "--n-11", "--n-12"]) text(token, 4.5);
+
+	const onGround = (name: string, hex: string, least = 4.5) => {
+		tokens[name] = hex;
+		text(name, least);
+	};
+	onGround("--a-11", theme.turn);
+	onGround("--done", theme.done);
+	onGround("--running", theme.running);
+	onGround("--stuck", theme.stuck);
+	onGround("--closed", theme.services[1]);
+	const fill = readable(theme.turn, ground, 3);
+	tokens["--a-9"] = fill;
+	tokens["--a-10"] = mix(fill, ink, 0.12);
+	tokens["--a-5"] = mix(ground, theme.turn, 0.3);
+	tokens["--a-3"] = mix(ground, theme.turn, 0.15);
+	tokens["--turn-fg"] =
+		contrast("#ffffff", fill) >= contrast("#000000", fill) ? "#ffffff" : "#000000";
+
+	theme.lines.forEach((hex, i) => {
+		tokens[`--line-${i}`] = hex;
+	});
+	theme.services.forEach((hex, i) => {
+		tokens[`--svc-${i}`] = hex;
+	});
+	tokens["--ty-fact"] = theme.services[2];
+	tokens["--ty-turn"] = theme.services[3];
+	tokens["--ty-step"] = theme.services[4];
+	tokens["--ty-checks"] = theme.services[5];
+	tokens["--line-strength"] = `${theme.tint}%`;
+	return {tokens, moved};
+};
+
+// Applying one. One task: every token, then every terminal, so a frame sees all of it or none.
+
+type Listener = (colors: TerminalColors | null) => void;
+const listeners = new Set<Listener>();
+let current: Theme | null = null;
+let setNames: readonly string[] = [];
+
+/** What a terminal draws with now; null is the app's own look. */
+export const terminalColors = (): TerminalColors | null => current?.terminal ?? null;
+
+/** Hear each change of theme. Answers how to stop hearing. */
+export const onTheme = (listener: Listener) => {
+	listeners.add(listener);
+	return () => {
+		listeners.delete(listener);
+	};
+};
+
+const CACHE = "fabrika.theme.tokens";
+const WHOLE = "fabrika.theme";
+
+export const applyTheme = (theme: Theme | null): void => {
+	const root = document.documentElement;
+	for (const name of setNames) root.style.removeProperty(name);
+	current = theme;
+	if (theme === null) {
+		setNames = [];
+		root.style.removeProperty("color-scheme");
+		delete root.dataset.theme;
+		localStorage.removeItem(CACHE);
+		localStorage.removeItem(WHOLE);
+	} else {
+		const {tokens} = tokensOf(theme);
+		for (const [name, value] of Object.entries(tokens)) root.style.setProperty(name, value);
+		root.style.setProperty("color-scheme", theme.look);
+		root.dataset.theme = theme.name;
+		setNames = Object.keys(tokens);
+		localStorage.setItem(CACHE, JSON.stringify({look: theme.look, tokens}));
+		localStorage.setItem(WHOLE, JSON.stringify(theme));
+	}
+	for (const listener of listeners) listener(terminalColors());
+};
+
+/** The last theme again, before any terminal is made: the store is read as any other input is. */
+export const restoreTheme = (): void => {
+	const kept = localStorage.getItem(WHOLE);
+	if (kept !== null) applyTheme(decodeTheme(JSON.parse(kept)));
+};
