+// SPIKE for experiment 177. The page's first script, before its first paint: the tokens of the
+// last theme, read from this browser's own store, set before anything draws, so a start shows no
+// flash of the app's own look. VS Code restores its last colors the same way. Only a #rrggbb or a
+// percent is taken, so a changed store cannot put anything else in a token.
+const kept = localStorage.getItem("fabrika.theme.tokens");
+performance.mark("theme-first");
+if (kept !== null) {
+	const {look, tokens} = JSON.parse(kept);
+	const root = document.documentElement;
+	for (const [name, value] of Object.entries(tokens))
+		if (/^--[a-z0-9-]+$/.test(name) && /^(#[0-9a-f]{6}|\d{1,3}%)$/.test(value))
+			root.style.setProperty(name, value);
+	if (look === "dark" || look === "light") root.style.setProperty("color-scheme", look);
+}
