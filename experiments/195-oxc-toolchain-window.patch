+/**
+ * Experiment 195 part 3: a narrow handle, so one part of the window reads only its own part of the
+ * model through the same `useRuntime`, and sends only its own messages (Elm's `Html.map`).
+ *
+ * tea 0.21.0's hook takes no selector: `useRuntime(handle)` is `useSyncExternalStore(subscribe,
+ * getState)` over the whole model, so any component that calls it runs on every change. A part is
+ * read by handing the same hook a handle whose `getState` returns only that part, the same object
+ * while it holds. The awkward bit is the type: `BootedRunHandle` has eight fields and the hook uses
+ * three (`subscribe`, `getState`, `dispatch`). The other five must still be filled, and `observe`
+ * cannot be, because a window Msg does not map back to the part's own.
+ */
+const narrow = <A, N extends {readonly type: string}>(
+	root: BootedRunHandle<Model, Msg>,
+	pick: (model: Model) => A,
+	same: (a: A, b: A) => boolean,
+	send: (msg: N) => Msg,
+): BootedRunHandle<A, N> => {
+	let seen: {readonly model: Model; readonly part: A} | undefined;
+	const getState = (): A => {
+		const model = root.getState();
+		if (seen?.model === model) return seen.part;
+		const next = pick(model);
+		const part = seen !== undefined && same(seen.part, next) ? seen.part : next;
+		seen = {model, part};
+		return part;
+	};
+	const part: BootedRunHandle<A, N> = {
+		getState,
+		subscribe: (listener) => root.subscribe(listener),
+		dispatch: (msg) => root.dispatch(send(msg)),
+		onBoot: (handler) => {
+			handler(getState());
+			return () => {};
+		},
+		on: () => () => {},
+		observe: () => {
+			throw new Error("a narrow handle cannot observe: a window Msg does not map back to a part's");
+		},
+		// The root owns the run; a part never stops it.
+		stop: () => Promise.resolve(),
+		get ready() {
+			return Promise.resolve(part);
+		},
+	};
+	return part;
+};
