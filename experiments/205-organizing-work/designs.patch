diff --git a/packages/pipeline/src/tickets/area.ts b/packages/pipeline/src/tickets/area.ts
new file mode 100644
index 00000000..6f91fb39
--- /dev/null
+++ b/packages/pipeline/src/tickets/area.ts
@@ -0,0 +1,172 @@
+import {Schema} from "effect";
+import {AREAS, Area, type Entry, factsOf, type Ticket} from "./ticket.ts";
+
+// A design sketch (a local branch, not for merge): a ticket's area, worked out from the
+// code. Nobody types it. Three places say it, and the strongest wins:
+//
+//   its own pull request's files   the `pr` fact's pull request, its files read from GitHub
+//   the filer's guess              the `area` code wrote on `filed`
+//   where it came from             the `from` on `filed`: a follow-up takes its source's area
+//
+//   placedOf(ticket186, filesOf)
+//   // {area: "pipeline", how: {_tag: "from", pr: 357, files: 6, total: 6}}
+//   areaOfPath("packages/pipeline/src/lane/work.ts")   "pipeline"
+//
+// Areas are few, and each is a set of top folders (`FOLDERS`). The list came from the repo: the
+// top folders of main, merged where one part spans two (the ledger, the host), with one area per
+// program that has a window.
+
+export {AREAS, Area};
+
+/** Each area's folders, first match wins: the order matters where one folder sits in another. */
+export const FOLDERS: ReadonlyArray<{readonly area: Area; readonly paths: readonly string[]}> = [
+	{area: "next", paths: ["next/"]},
+	{
+		area: "ledger",
+		paths: [
+			"packages/ledger-server/",
+			"packages/fabrika/src/host/ledger.ts",
+			"packages/fabrika/src/host/sqlite",
+			"packages/fabrika/src/host/records.ts",
+			"packages/fabrika/src/host/door.ts",
+			"packages/fabrika/src/host/durable-object.ts",
+			"packages/fabrika/src/host/writer.ts",
+			"packages/fabrika/src/host/signer.ts",
+			"packages/fabrika/src/host/sshsig.ts",
+			"packages/fabrika/src/host/keys",
+			"packages/fabrika/src/host/http.ts",
+			"apps/fabrika/src/host/connection.ts",
+			"apps/fabrika/src/host/move",
+			"apps/fabrika/src/host/shared",
+		],
+	},
+	{area: "tracker", paths: ["programs/tracker/", "packages/pipeline/src/tickets/"]},
+	{area: "ticket", paths: ["programs/ticket/"]},
+	// `runs` became the trace's ticket view (PR 338); older pull requests still name it.
+	{area: "trace", paths: ["programs/trace/", "programs/runs/"]},
+	{area: "map", paths: ["programs/map/"]},
+	{area: "markdown", paths: ["programs/markdown/"]},
+	{
+		area: "experiments",
+		paths: ["programs/experiments/", "programs/experiment/", "programs/compare/"],
+	},
+	{
+		area: "tsh",
+		paths: [
+			"packages/fabrika/src/shell/",
+			"apps/fabrika/src/tsh.ts",
+			"apps/fabrika/src/tsh.test.ts",
+		],
+	},
+	{area: "pipeline", paths: ["packages/pipeline/", "programs/pipeline/"]},
+	{
+		area: "agents",
+		paths: [
+			"packages/fabrika/src/agents/",
+			"packages/fabrika/src/mcp",
+			"packages/fabrika/src/sandbox/",
+		],
+	},
+	{
+		area: "host",
+		paths: [
+			"packages/fabrika/src/host/",
+			"packages/fabrika/src/program/",
+			"apps/fabrika/src/host/",
+			"packages/tea-host/",
+			"packages/tea-program/",
+		],
+	},
+	{area: "app", paths: ["apps/fabrika/"]},
+	{area: "lint", paths: ["oxlint-plugins/"]},
+];
+
+/** The area a file is in, or `null`: docs, experiments, field notes and root files are in none. */
+export const areaOfPath = (path: string): Area | null =>
+	FOLDERS.find((f) => f.paths.some((p) => path.startsWith(p)))?.area ?? null;
+
+/** How a ticket's area was worked out. `files` of `total`: how many of the PR's files say so. */
+export const How = Schema.Union([
+	Schema.TaggedStruct("pr", {pr: Schema.Int, files: Schema.Int, total: Schema.Int}),
+	Schema.TaggedStruct("guess", {}),
+	Schema.TaggedStruct("from", {pr: Schema.Int, files: Schema.Int, total: Schema.Int}),
+]);
+export type How = typeof How.Type;
+
+export const Placed = Schema.Struct({area: Area, how: How});
+export type Placed = typeof Placed.Type;
+
+/** A pull request's files, by its number: GitHub's answer, or `undefined` when not read. */
+export type FilesOf = (pr: number) => readonly string[] | undefined;
+
+/** The area most of a pull request's files are in; a tie goes to the first in `AREAS`. */
+export const areaOfFiles = (
+	files: readonly string[],
+): {readonly area: Area; readonly files: number} | null => {
+	const counts = new Map<Area, number>();
+	for (const file of files) {
+		const area = areaOfPath(file);
+		if (area !== null) counts.set(area, (counts.get(area) ?? 0) + 1);
+	}
+	let best: {area: Area; files: number} | null = null;
+	for (const area of AREAS) {
+		const n = counts.get(area) ?? 0;
+		if (n > 0 && (best === null || n > best.files)) best = {area, files: n};
+	}
+	return best;
+};
+
+const prNumberOf = (url: string): number | null => {
+	const m = url.match(/\/pull\/([1-9]\d*)$/);
+	return m === null ? null : Number(m[1]);
+};
+
+const fromPr = (
+	url: string,
+	filesOf: FilesOf,
+): {
+	readonly area: Area;
+	readonly pr: number;
+	readonly files: number;
+	readonly total: number;
+} | null => {
+	const pr = prNumberOf(url);
+	const files = pr === null ? undefined : filesOf(pr);
+	const found = files === undefined ? null : areaOfFiles(files);
+	return pr === null || files === undefined || found === null
+		? null
+		: {area: found.area, pr, files: found.files, total: files.length};
+};
+
+/** A ticket's area and how it was worked out, or `null`: nothing says it yet. */
+export const placedOf = (ticket: Ticket, filesOf: FilesOf): Placed | null =>
+	placedOn(ticket.timeline, filesOf);
+
+export const placedOn = (timeline: readonly Entry[], filesOf: FilesOf): Placed | null => {
+	const own = factsOf(timeline, "pr")
+		.map((pr) => fromPr(pr.url, filesOf))
+		.findLast((p) => p !== null);
+	if (own !== undefined && own !== null)
+		return {area: own.area, how: {_tag: "pr", pr: own.pr, files: own.files, total: own.total}};
+	const filed = factsOf(timeline, "filed")[0];
+	if (filed?.area !== undefined) return {area: filed.area, how: {_tag: "guess"}};
+	const from = filed?.from?._tag === "pr" ? fromPr(filed.from.url, filesOf) : null;
+	if (from !== null)
+		return {
+			area: from.area,
+			how: {_tag: "from", pr: from.pr, files: from.files, total: from.total},
+		};
+	return null;
+};
+
+/** How it was worked out, in a few words. */
+export const howWords = (how: How): string => {
+	switch (how._tag) {
+		case "pr":
+			return `from PR ${how.pr}'s files, ${how.files} of ${how.total}`;
+		case "guess":
+			return "the filer's guess";
+		case "from":
+			return `from its source, PR ${how.pr}: ${how.files} of ${how.total} files`;
+	}
+};
