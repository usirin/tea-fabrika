+
+/*
+ * A design sketch (a local branch, not for merge): the list by area, four ways
+ * (programs/tracker/src/area-window.tsx), and the areas program (programs/areas). Tokens only,
+ * the two text steps (slate 12, slate a11), no box around a list: the rows and the headings are
+ * the only edges. A picked row is a full-row fill and a heavier title, never a side bar.
+ */
+
+.tracker-column:has(.area-page) {
+	max-width: none;
+	padding: 0;
+}
+
+.area-page,
+.areas {
+	flex: 1 0 auto;
+	display: flex;
+	flex-direction: column;
+	min-height: 0;
+	container: area / inline-size;
+	outline: none;
+}
+
+.areas {
+	flex: 1;
+	background: var(--ground);
+	color: var(--text-faint);
+	font-family: var(--sans);
+	font-size: var(--fs-body);
+	line-height: 1.45;
+	-webkit-font-smoothing: antialiased;
+}
+
+.area-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: baseline;
+	gap: var(--s-1) var(--s-2);
+	padding: var(--s-4) var(--s-5) var(--s-2);
+}
+
+.area-head h2 {
+	margin: 0;
+	color: var(--text-primary);
+	font-size: var(--fs-head);
+	font-weight: 500;
+}
+
+.area-head h2::first-letter,
+.area-name::first-letter,
+.areas-name::first-letter,
+.area-prop::first-letter {
+	text-transform: uppercase;
+}
+
+.area-count {
+	color: var(--text-faint);
+	font-size: var(--fs-small);
+	font-variant-numeric: tabular-nums;
+}
+
+.area-folders,
+.area-words {
+	flex-basis: 100%;
+	margin: 0;
+	overflow: hidden;
+	color: var(--text-faint);
+	font-size: var(--fs-small);
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+/* In the page's column, a basis of 100% would be the whole height: it takes its own. */
+.area-words {
+	flex: none;
+	padding: 0 var(--s-5) var(--s-2);
+}
+
+/* The saved views: plain words in a row, the one shown filled. */
+.area-views {
+	display: flex;
+	align-items: center;
+	gap: var(--s-1);
+	padding: var(--s-3) var(--s-4) var(--s-2);
+	overflow: hidden;
+}
+
+.area-page .area-views button {
+	flex: none;
+	padding: var(--s-1) var(--s-2);
+	border: none;
+	border-radius: var(--r);
+	background: transparent;
+	color: var(--text-faint);
+	font: inherit;
+	font-weight: 500;
+	white-space: nowrap;
+}
+
+.area-page .area-views button:hover {
+	background: var(--hover);
+}
+
+.area-page .area-views button[aria-current="page"] {
+	background: var(--pick);
+	color: var(--text-primary);
+}
+
+.area-page .area-views button:focus-visible,
+.area-filters button:focus-visible,
+.area-group h3 button:focus-visible {
+	outline: 2px solid var(--focus);
+	outline-offset: -2px;
+}
+
+.area-views .area-count {
+	margin-left: auto;
+	padding-left: var(--s-2);
+}
+
+.area-filters {
+	position: relative;
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: var(--s-2);
+	padding: 0 var(--s-5) var(--s-2);
+}
+
+.area-chip {
+	display: inline-flex;
+	align-items: center;
+	gap: var(--s-1);
+	padding: 2px 2px 2px var(--s-2);
+	border-radius: var(--r);
+	background: var(--pick);
+	color: var(--text-primary);
+	font-size: var(--fs-small);
+}
+
+.area-page .area-chip button,
+.area-page .area-add {
+	border: none;
+	border-radius: var(--r-sm);
+	background: transparent;
+	color: var(--text-faint);
+	font: inherit;
+	font-size: var(--fs-small);
+}
+
+.area-page .area-chip button {
+	padding: 0 var(--s-1);
+}
+
+.area-page .area-add {
+	display: inline-flex;
+	align-items: center;
+	gap: var(--s-1);
+	padding: 2px var(--s-2);
+}
+
+.area-page .area-chip button:hover,
+.area-page .area-add:hover {
+	background: var(--hover);
+	color: var(--text-primary);
+}
+
+.area-menu {
+	position: absolute;
+	top: calc(100% + var(--s-1));
+	left: var(--s-5);
+	z-index: 2;
+	min-width: 200px;
+	margin: 0;
+	padding: var(--pop-pad);
+	border: 1px solid var(--pop-edge);
+	border-radius: var(--r-lg);
+	background: var(--pop-bg);
+	box-shadow: var(--pop-shadow);
+	outline: none;
+}
+
+.area-menu [role="option"] {
+	display: flex;
+	justify-content: space-between;
+	gap: var(--s-4);
+	padding: 6px var(--s-2);
+	border-radius: var(--r);
+	color: var(--text-primary);
+	cursor: default;
+}
+
+.area-menu [role="option"] span::first-letter {
+	text-transform: uppercase;
+}
+
+.area-menu [role="option"][aria-selected="true"] {
+	background: var(--row-on);
+}
+
+.area-scroll {
+	flex: 1 0 auto;
+	padding: 0 var(--s-2) var(--s-2);
+}
+
+.area-group h3 {
+	margin: 0;
+	font-size: inherit;
+	font-weight: inherit;
+}
+
+.area-group h3 button {
+	display: flex;
+	align-items: center;
+	gap: var(--s-2);
+	width: 100%;
+	box-sizing: border-box;
+	margin-top: var(--s-2);
+	padding: 6px 10px;
+	border: none;
+	border-radius: var(--r);
+	background: transparent;
+	color: var(--text-primary);
+	font: inherit;
+	font-weight: 500;
+	text-align: left;
+}
+
+.area-group h3 button:hover {
+	background: var(--hover);
+}
+
+.area-chevron {
+	width: 12px;
+	height: 12px;
+	flex: none;
+	fill: none;
+	stroke: var(--text-faint);
+	stroke-width: 1.5;
+	transition: transform var(--fast) var(--ease-out);
+}
+
+.area-chevron[data-open="true"] {
+	transform: rotate(90deg);
+}
+
+.area-rows {
+	margin: 0;
+	padding: 0;
+	list-style: none;
+}
+
+/* One ticket row: state, number, title, then its area (B3) and when, quiet, at the right. */
+.area-page .area-row {
+	display: grid;
+	grid-template-columns: 16px 3.5ch minmax(0, 1fr) auto auto;
+	gap: 10px;
+	align-items: center;
+	width: 100%;
+	box-sizing: border-box;
+	min-height: var(--row-h);
+	padding: 6px 10px;
+	border: none;
+	border-radius: var(--r);
+	background: transparent;
+	color: var(--text-faint);
+	font: inherit;
+	text-align: left;
+}
+
+.area-page .area-row:hover {
+	background: var(--hover);
+}
+
+.area-page .area-row[aria-current="true"] {
+	background: var(--pick);
+}
+
+.area-row[aria-current="true"] .area-title {
+	font-weight: 500;
+}
+
+.area-page .area-row:focus-visible {
+	outline: none;
+}
+
+.area-glyph {
+	width: 14px;
+	height: 14px;
+	color: var(--text-faint);
+}
+
+.area-number {
+	font-variant-numeric: tabular-nums;
+	text-align: right;
+}
+
+.area-title {
+	overflow: hidden;
+	color: var(--text-primary);
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.area-prop,
+.area-when {
+	font-size: var(--fs-small);
+	white-space: nowrap;
+}
+
+.area-empty {
+	margin: 0;
+	padding: var(--s-4) 10px;
+	color: var(--text-faint);
+}
+
+.area-keys {
+	display: flex;
+	flex-wrap: wrap;
+	gap: var(--s-1) var(--s-4);
+	padding: var(--s-2) var(--s-5) var(--s-3);
+	color: var(--text-faint);
+	font-size: var(--fs-small);
+}
+
+/* The areas program's rows: name and count on one line, the folders under it. */
+.areas .area-rows {
+	padding: 0 var(--s-2);
+}
+
+.areas .areas-row {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr) auto auto;
+	column-gap: var(--s-2);
+	align-items: baseline;
+	width: 100%;
+	box-sizing: border-box;
+	padding: 6px 10px;
+	border: none;
+	border-radius: var(--r);
+	background: transparent;
+	color: var(--text-faint);
+	font: inherit;
+	text-align: left;
+}
+
+.areas .areas-row:hover {
+	background: var(--hover);
+}
+
+.areas .areas-row[aria-current="true"] {
+	background: var(--pick);
+}
+
+.areas-row[aria-current="true"] .areas-name {
+	font-weight: 500;
+}
+
+.areas .areas-row:focus-visible {
+	outline: none;
+}
+
+.areas-name {
+	color: var(--text-primary);
+}
+
+.areas-sent {
+	grid-column: 3;
+	grid-row: 1;
+	font-size: var(--fs-small);
+}
+
+.areas-folders {
+	grid-column: 1 / -1;
+	overflow: hidden;
+	font-size: var(--fs-small);
+	text-overflow: ellipsis;
+	white-space: nowrap;
+}
+
+.areas-quiet {
+	margin: 0;
+	padding: var(--s-2) var(--s-5);
+	font-size: var(--fs-small);
+}
+
+@container area (max-width: 520px) {
+	.area-page .area-row {
+		grid-template-columns: 16px 3.5ch minmax(0, 1fr) auto;
+	}
+
+	.area-when {
+		display: none;
+	}
+}
+
+@container area (max-width: 380px) {
+	.area-page .area-row {
+		grid-template-columns: 3.5ch minmax(0, 1fr) auto;
+		gap: var(--s-2);
+	}
+
+	.area-glyph,
+	.area-keys,
+	.areas-folders {
+		display: none;
+	}
+
+	.area-head,
+	.area-filters,
+	.area-words {
+		padding-inline: var(--s-3);
+	}
+}
