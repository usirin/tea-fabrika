@@ -0,0 +1,451 @@
+import type {WindowProps} from "@kampus/fabrika-old";
+import {FOLDERS, howWords} from "@kampus/pipeline/tickets/area";
+import {Kbd} from "@manti-ui/react";
+import {type KeyboardEvent, useEffect, useEffectEvent, useRef, useState} from "react";
+import {AREA_VIEWS, type AreaFilter, areaWords, SAVED} from "./area-filter.ts";
+import type {Listed, Shown, tracker} from "./index.ts";
+
+// A design sketch (a local branch, not for merge): the tracker's list, drawn four ways
+// for the area study's step 5. Today's list (./window.tsx) draws when no design is asked for.
+//
+//   tracker --group area | ticket        b1: a heading per area, folded with ← and →, [ ] to jump
+//   areas | tracker | ticket             b2: one area, picked in the `areas` tile
+//   tracker --area pipeline | ticket     b3: area views on top, a filter (f), the area on each row
+//   tracker --saved pipeline | ticket    c:  saved views of title words, no area anywhere
+//
+// Keys and the mouse do the same things: j k or ↑ ↓ move, Enter or a click sends the ticket on
+// (`{pick: n}`), and the list stays. A selected row is a full-row fill and stronger text.
+
+type Send = WindowProps<typeof tracker>["send"];
+type ListView = Extract<Shown["page"], {kind: "list"}>;
+
+/** When, in a few words, as the list says it: the time today, else the day. */
+const shortWhen = (at: number, now: number): string => {
+	const then = new Date(at);
+	if (then.toDateString() === new Date(now).toDateString())
+		return then.toLocaleTimeString("en-GB", {hour: "2-digit", minute: "2-digit"});
+	return then.toLocaleDateString("en-GB", {day: "numeric", month: "short"});
+};
+
+const OpenGlyph = () => (
+	<svg className="area-glyph" viewBox="0 0 16 16" role="img" aria-label="open">
+		<circle cx="8" cy="8" r="5.25" fill="none" stroke="currentColor" strokeWidth="1.5" />
+	</svg>
+);
+
+const Chevron = ({open}: {readonly open: boolean}) => (
+	<svg className="area-chevron" data-open={open} viewBox="0 0 16 16" aria-hidden="true">
+		<path
+			d="M6 4l4 4-4 4"
+			fill="none"
+			stroke="currentColor"
+			strokeWidth="1.5"
+			strokeLinecap="round"
+			strokeLinejoin="round"
+		/>
+	</svg>
+);
+
+/** The groups b1 draws: every area with a ticket, the most first, and the unplaced last. */
+const groupsOf = (page: ListView) => {
+	const areas = page.areas
+		.filter((a) => a.area !== "none" && a.count > 0)
+		.toSorted((a, b) => b.count - a.count);
+	const none = page.areas.find((a) => a.area === "none");
+	const all = none === undefined || none.count === 0 ? areas : [...areas, none];
+	return all.map(({area}) => ({
+		area,
+		tickets: page.tickets.filter((t) =>
+			area === "none" ? t.placed === null : t.placed?.area === area,
+		),
+	}));
+};
+
+const foldersOf = (area: AreaFilter) =>
+	area === "none" ? [] : (FOLDERS.find((f) => f.area === area)?.paths ?? []);
+
+export function AreaList({
+	view,
+	page,
+	send,
+}: {
+	readonly view: Shown;
+	readonly page: ListView;
+	readonly send: Send;
+}) {
+	const design = view.filter.design;
+	const [picked, setPicked] = useState<number | null>(null);
+	const [folded, setFolded] = useState<ReadonlySet<AreaFilter>>(new Set());
+	const [menu, setMenu] = useState(false);
+	const rows = useRef(new Map<number, HTMLButtonElement>());
+	const heads = useRef(new Map<AreaFilter, HTMLButtonElement>());
+	const pageRef = useRef<HTMLElement>(null);
+	const groups = design === "b1" ? groupsOf(page) : [];
+	const order =
+		design === "b1"
+			? groups.flatMap((g) => (folded.has(g.area) ? [] : g.tickets.map((t) => t.number)))
+			: page.tickets.map((t) => t.number);
+	const current = order.find((n) => n === picked) ?? order[0];
+
+	const focusStart = useEffectEvent(() => {
+		if (current !== undefined) rows.current.get(current)?.focus();
+		else pageRef.current?.focus();
+	});
+	// On coming to the list, and after each change of what it shows, the focus goes back to a row.
+	useEffect(() => {
+		focusStart();
+	}, [view.filter.area, view.filter.saved]);
+
+	const focusRow = (n: number | undefined) => {
+		if (n === undefined) return;
+		setPicked(n);
+		rows.current.get(n)?.focus();
+	};
+	const move = (by: number) => {
+		const at = order.indexOf(current ?? -1);
+		focusRow(order[Math.min(order.length - 1, Math.max(0, at + by))]);
+	};
+	const pick = (n: number) => {
+		setPicked(n);
+		send({type: "query", value: {pick: n}});
+	};
+	const filter = (value: {
+		readonly area?: AreaFilter | null;
+		readonly saved?: (typeof SAVED)[number]["name"] | null;
+	}) => send({type: "query", value: {status: view.filter.show, find: view.filter.find, ...value}});
+
+	const groupOf = (n: number | undefined) =>
+		groups.find((g) => g.tickets.some((t) => t.number === n))?.area;
+	const fold = (area: AreaFilter, on: boolean) => {
+		setFolded((all) => {
+			const next = new Set(all);
+			if (on) next.add(area);
+			else next.delete(area);
+			return next;
+		});
+		if (on) heads.current.get(area)?.focus();
+	};
+	/** The next open group's first row, from the group of `from` (a heading) or of the row. */
+	const jump = (by: number, from: AreaFilter | undefined) => {
+		const at = groups.findIndex((g) => g.area === (from ?? groupOf(current)));
+		for (let i = at + by; i >= 0 && i < groups.length; i += by) {
+			const g = groups[i];
+			if (g !== undefined && !folded.has(g.area) && g.tickets.length > 0)
+				return focusRow(g.tickets[0]?.number);
+		}
+	};
+	const views = design === "c" ? null : AREA_VIEWS;
+	const stepView = (by: number) => {
+		if (design === "c") {
+			const names = [null, ...SAVED.map((s) => s.name)];
+			const at = names.indexOf(view.filter.saved as never);
+			const next = names[(at + by + names.length) % names.length];
+			filter({saved: (next ?? null) as never});
+		} else if (views !== null) {
+			const at = views.findIndex((v) => v.area === view.filter.area);
+			filter({area: views[(at + by + views.length) % views.length]?.area ?? null});
+		}
+	};
+
+	const onKey = (e: KeyboardEvent) => {
+		if (e.ctrlKey || e.metaKey || e.altKey) return;
+		if (menu) return;
+		const onHead = (e.target as HTMLElement).dataset.head as AreaFilter | undefined;
+		const keys: Readonly<Record<string, () => void>> = {
+			ArrowDown: () => move(1),
+			j: () => move(1),
+			ArrowUp: () => move(-1),
+			k: () => move(-1),
+			q: () => send({type: "quit", value: null}),
+			...(design === "b1"
+				? {
+						"]": () => jump(1, onHead),
+						"[": () => jump(-1, onHead),
+						ArrowLeft: () => {
+							const area = onHead ?? groupOf(current);
+							if (area !== undefined) fold(area, true);
+						},
+						ArrowRight: () => {
+							if (onHead !== undefined) {
+								fold(onHead, false);
+								setTimeout(() =>
+									focusRow(groups.find((g) => g.area === onHead)?.tickets[0]?.number),
+								);
+							}
+						},
+					}
+				: {}),
+			...(design === "b3" || design === "c"
+				? {"]": () => stepView(1), "[": () => stepView(-1)}
+				: {}),
+			...(design === "b3" ? {f: () => setMenu(true), Backspace: () => filter({area: null})} : {}),
+		};
+		const key = keys[e.key];
+		if (key === undefined) return;
+		e.preventDefault();
+		key();
+	};
+
+	const row = (t: Listed, opts: {readonly area: boolean}) => (
+		<li key={t.number}>
+			<button
+				type="button"
+				className="area-row"
+				ref={(el) => {
+					if (el === null) rows.current.delete(t.number);
+					else rows.current.set(t.number, el);
+				}}
+				tabIndex={t.number === current ? 0 : -1}
+				aria-current={t.number === current}
+				onFocus={() => setPicked(t.number)}
+				onClick={() => pick(t.number)}
+			>
+				<OpenGlyph />
+				<span className="area-number">{t.number}</span>
+				<span className="area-title">{t.title}</span>
+				{opts.area ? (
+					<span className="area-prop" title={t.placed === null ? "" : howWords(t.placed.how)}>
+						{t.placed === null ? "No area" : t.placed.area}
+					</span>
+				) : null}
+				<span className="area-when">{shortWhen(t.at, Date.now())}</span>
+			</button>
+		</li>
+	);
+
+	const savedNow = SAVED.find((s) => s.name === view.filter.saved);
+	const count = page.tickets.length;
+	return (
+		<section
+			aria-label="list page"
+			className="area-page"
+			data-design={design}
+			ref={pageRef}
+			tabIndex={-1}
+			onKeyDown={onKey}
+		>
+			{design === "b2" && view.filter.area !== null ? (
+				<header className="area-head">
+					<h2>{areaWords(view.filter.area)}</h2>
+					<span className="area-count">{count} open</span>
+					<p className="area-folders">
+						{foldersOf(view.filter.area).length === 0
+							? "Nothing places these yet: no pull request, no guess"
+							: foldersOf(view.filter.area).join(", ")}
+					</p>
+				</header>
+			) : null}
+			{design === "b1" ? (
+				<header className="area-head">
+					<h2>Open, by area</h2>
+					<span className="area-count">{count} open</span>
+				</header>
+			) : null}
+			{design === "b3" || design === "c" ? (
+				<nav className="area-views" aria-label="saved views">
+					{(design === "c"
+						? [
+								{label: "All open", key: null as string | null},
+								...SAVED.map((s) => ({label: s.label, key: s.name as string | null})),
+							]
+						: AREA_VIEWS.map((v) => ({label: v.label, key: v.area as string | null}))
+					).map((v) => {
+						const on = design === "c" ? view.filter.saved === v.key : view.filter.area === v.key;
+						return (
+							<button
+								key={v.label}
+								type="button"
+								aria-current={on ? "page" : undefined}
+								onClick={() =>
+									design === "c"
+										? filter({saved: v.key as never})
+										: filter({area: v.key as AreaFilter | null})
+								}
+							>
+								{v.label}
+							</button>
+						);
+					})}
+					<span className="area-count">{count}</span>
+				</nav>
+			) : null}
+			{design === "c" ? (
+				<p className="area-words">
+					{savedNow === undefined
+						? "Every open ticket"
+						: `Titles with any of: ${savedNow.words.join(", ")}`}
+				</p>
+			) : null}
+			{design === "b3" ? (
+				<div className="area-filters">
+					{view.filter.area === null ? null : (
+						<span className="area-chip">
+							Area is {areaWords(view.filter.area)}
+							<button
+								type="button"
+								aria-label={`remove the filter: area is ${areaWords(view.filter.area)}`}
+								onClick={() => filter({area: null})}
+							>
+								×
+							</button>
+						</span>
+					)}
+					<button type="button" className="area-add" onClick={() => setMenu(true)}>
+						Filter <Kbd>f</Kbd>
+					</button>
+					{menu ? (
+						<AreaMenu
+							page={page}
+							now={view.filter.area}
+							choose={(area) => {
+								setMenu(false);
+								filter({area});
+								pageRef.current?.focus();
+							}}
+							close={() => {
+								setMenu(false);
+								focusRow(current);
+							}}
+						/>
+					) : null}
+				</div>
+			) : null}
+			<div className="area-scroll">
+				{design === "b1" ? (
+					groups.map((g) => {
+						const open = !folded.has(g.area);
+						const id = `area-group-${g.area}`;
+						return (
+							<section key={g.area} className="area-group" aria-labelledby={id}>
+								<h3 id={id}>
+									<button
+										type="button"
+										data-head={g.area}
+										aria-expanded={open}
+										tabIndex={-1}
+										ref={(el) => {
+											if (el === null) heads.current.delete(g.area);
+											else heads.current.set(g.area, el);
+										}}
+										onClick={() => fold(g.area, open)}
+									>
+										<Chevron open={open} />
+										<span className="area-name">{areaWords(g.area)}</span>
+										<span className="area-count">{g.tickets.length}</span>
+									</button>
+								</h3>
+								{open ? (
+									<ol className="area-rows">{g.tickets.map((t) => row(t, {area: false}))}</ol>
+								) : null}
+							</section>
+						);
+					})
+				) : count === 0 ? (
+					<p className="area-empty">No open ticket here.</p>
+				) : (
+					<ol className="area-rows" aria-label="tickets">
+						{page.tickets.map((t) => row(t, {area: design === "b3"}))}
+					</ol>
+				)}
+			</div>
+			<footer className="area-keys">
+				<span>
+					<Kbd>j</Kbd> <Kbd>k</Kbd> move
+				</span>
+				<span>
+					<Kbd>Enter</Kbd> show
+				</span>
+				{design === "b1" ? (
+					<>
+						<span>
+							<Kbd>[</Kbd> <Kbd>]</Kbd> area
+						</span>
+						<span>
+							<Kbd>←</Kbd> <Kbd>→</Kbd> fold
+						</span>
+					</>
+				) : null}
+				{design === "b3" || design === "c" ? (
+					<span>
+						<Kbd>[</Kbd> <Kbd>]</Kbd> view
+					</span>
+				) : null}
+				{design === "b3" ? (
+					<span>
+						<Kbd>f</Kbd> filter
+					</span>
+				) : null}
+			</footer>
+		</section>
+	);
+}
+
+/** B3's filter menu: every area with its count, chosen by keys or a click. Escape closes it. */
+function AreaMenu(props: {
+	readonly page: ListView;
+	readonly now: AreaFilter | null;
+	readonly choose: (area: AreaFilter) => void;
+	readonly close: () => void;
+}) {
+	const items = props.page.areas.filter((a) => a.count > 0 || a.area === props.now);
+	const [at, setAt] = useState(
+		Math.max(
+			0,
+			items.findIndex((a) => a.area === props.now),
+		),
+	);
+	const ref = useRef<HTMLDivElement>(null);
+	useEffect(() => {
+		ref.current?.focus();
+	}, []);
+	const onKey = (e: KeyboardEvent) => {
+		const keys: Readonly<Record<string, () => void>> = {
+			ArrowDown: () => setAt((i) => Math.min(items.length - 1, i + 1)),
+			j: () => setAt((i) => Math.min(items.length - 1, i + 1)),
+			ArrowUp: () => setAt((i) => Math.max(0, i - 1)),
+			k: () => setAt((i) => Math.max(0, i - 1)),
+			Enter: () => {
+				const item = items[at];
+				if (item !== undefined) props.choose(item.area);
+			},
+			Escape: () => props.close(),
+		};
+		const key = keys[e.key];
+		if (key === undefined) return;
+		e.preventDefault();
+		e.stopPropagation();
+		key();
+	};
+	return (
+		<div
+			className="area-menu"
+			role="listbox"
+			aria-label="area"
+			tabIndex={0}
+			ref={ref}
+			aria-activedescendant={`area-menu-${items[at]?.area}`}
+			onKeyDown={onKey}
+			onBlur={(e) => {
+				if (!e.currentTarget.contains(e.relatedTarget)) props.close();
+			}}
+		>
+			{items.map((a, i) => (
+				<div
+					key={a.area}
+					id={`area-menu-${a.area}`}
+					role="option"
+					tabIndex={-1}
+					aria-selected={i === at}
+					onMouseEnter={() => setAt(i)}
+					onMouseDown={(e) => {
+						e.preventDefault();
+						props.choose(a.area);
+					}}
+				>
+					<span>{areaWords(a.area)}</span>
+					<span className="area-count">{a.count}</span>
+				</div>
+			))}
+		</div>
+	);
+}
