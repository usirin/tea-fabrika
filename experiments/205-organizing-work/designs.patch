+import {AREAS, Area, type Placed, placedOf} from "@kampus/pipeline/tickets/area";
+import type {Ticket} from "@kampus/pipeline/tickets/ticket";
+import {Schema} from "effect";
+import {filesOf} from "./pr-files.ts";
+
+// A design sketch (a local branch, not for merge): what the list shows by area, and the
+// saved views. Four designs read it, each from its own line:
+//
+//   tracker --group area | ticket        B1: the list grouped by area, a heading per area
+//   areas | tracker | ticket             B2: the `areas` program picks one; the tracker shows it
+//   tracker --area pipeline | ticket     B3: area as a property on each row, a filter, area views
+//   tracker --saved pipeline | ticket    C:  no area at all; a saved view is a set of title words
+//
+//   fitsArea("pipeline", placedOfTicket(ticket186))   true: its area is pipeline, from PR 357's files
+//   fitsArea("none", placedOfTicket(ticket116))       true: nothing says its area yet
+
+/** One area, or `none`: the tickets nothing places yet. */
+export const AreaFilter = Schema.Literals([...AREAS, "none"]);
+export type AreaFilter = typeof AreaFilter.Type;
+
+/** Which of the four designs the window draws (./machine.ts, `design`). */
+export const Design = Schema.Literals(["b1", "b2", "b3", "c"]);
+export type Design = typeof Design.Type;
+
+/** How the list is grouped. */
+export const Group = Schema.Literals(["none", "area"]);
+export type Group = typeof Group.Type;
+
+/**
+ * A saved view of design C: a name, and the title words it finds, any of them, in any case. Kept
+ * on the person's desk in the design (docs/direction/tracker-views-are-programs.md, section 4);
+ * here, a list in code.
+ */
+export const Saved = Schema.Struct({
+	name: Schema.String,
+	label: Schema.String,
+	words: Schema.Array(Schema.String),
+});
+export type Saved = typeof Saved.Type;
+
+/** Made up for the shoot: three views, from the title words today's tickets start with. */
+export const SAVED: readonly Saved[] = [
+	{
+		name: "pipeline",
+		label: "Pipeline",
+		words: ["lane", "pipeline", "mutation", "test writer", "exam", "self-fix", "11a"],
+	},
+	{
+		name: "app",
+		label: "App",
+		words: [
+			"app",
+			"frame",
+			"bottom line",
+			"info mode",
+			"desk",
+			"light look",
+			"radix",
+			"bars hidden",
+		],
+	},
+	{name: "host", label: "Host", words: ["host", "job tool"]},
+];
+export const SavedName = Schema.Literals(SAVED.map((s) => s.name) as [string, ...string[]]);
+
+/** B3's saved views: each an area filter, on the person's desk. Made up for the shoot. */
+export const AREA_VIEWS: ReadonlyArray<{readonly label: string; readonly area: AreaFilter | null}> =
+	[
+		{label: "All open", area: null},
+		{label: "Pipeline", area: "pipeline"},
+		{label: "App", area: "app"},
+		{label: "Host", area: "host"},
+		{label: "No area yet", area: "none"},
+	];
+
+/** An area's name as a heading says it. */
+export const areaWords = (area: AreaFilter): string => (area === "none" ? "No area yet" : area);
+
+/** Where a ticket is, worked out from the code. */
+export const placedOfTicket = (ticket: Ticket): Placed | null => placedOf(ticket, filesOf);
+
+/** Does a ticket placed so fit the area asked for? */
+export const fitsArea = (area: AreaFilter | null, placed: Placed | null): boolean =>
+	area === null || (area === "none" ? placed === null : placed?.area === area);
+
+/** Does a title fit a saved view: any of its words in it, in any case. */
+export const fitsSaved = (saved: string | null, title: string): boolean => {
+	if (saved === null) return true;
+	const view = SAVED.find((s) => s.name === saved);
+	const lower = title.toLowerCase();
+	return view === undefined || view.words.some((w) => lower.includes(w));
+};
+
+export {Area};
