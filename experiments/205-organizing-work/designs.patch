@@ -0,0 +1,101 @@
+import type {WindowProps} from "@kampus/fabrika-old";
+import {Kbd} from "@manti-ui/react";
+import {areaWords} from "@tea-fabrika/tracker";
+import {type KeyboardEvent, useEffect, useEffectEvent, useRef, useState} from "react";
+import type {AreaRow, areas} from "./index.ts";
+
+// The areas window: one row per area, its open count at the right and its folders under it. j k
+// or ↑ ↓ move, Enter or a click sends the area on. The area sent stays marked "shown".
+
+export function AreasWindow({view, send}: WindowProps<typeof areas>) {
+	const rows = view.rows.filter((r) => r.count > 0);
+	const quiet = view.rows.filter((r) => r.count === 0);
+	const [at, setAt] = useState<AreaRow["area"] | null>(null);
+	const [sent, setSent] = useState<AreaRow["area"] | null>(null);
+	const refs = useRef(new Map<string, HTMLButtonElement>());
+	const order = rows.map((r) => r.area);
+	const current = order.find((a) => a === at) ?? order[0];
+	const focusStart = useEffectEvent(() => {
+		if (current !== undefined) refs.current.get(current)?.focus();
+	});
+	useEffect(() => {
+		focusStart();
+	}, [view.ready]);
+	const move = (by: number) => {
+		const i = order.indexOf(current ?? "none");
+		const next = order[Math.min(order.length - 1, Math.max(0, i + by))];
+		if (next === undefined) return;
+		setAt(next);
+		refs.current.get(next)?.focus();
+	};
+	const pick = (area: AreaRow["area"]) => {
+		setAt(area);
+		setSent(area);
+		send({type: "query", value: {area}});
+	};
+	const onKey = (e: KeyboardEvent) => {
+		if (e.ctrlKey || e.metaKey || e.altKey) return;
+		const keys: Readonly<Record<string, () => void>> = {
+			ArrowDown: () => move(1),
+			j: () => move(1),
+			ArrowUp: () => move(-1),
+			k: () => move(-1),
+			q: () => send({type: "quit", value: null}),
+		};
+		const key = keys[e.key];
+		if (key === undefined) return;
+		e.preventDefault();
+		key();
+	};
+	return (
+		<section className="areas" aria-label="areas" onKeyDown={onKey}>
+			<header className="area-head">
+				<h2>Areas</h2>
+				<span className="area-count">{rows.length}</span>
+			</header>
+			{!view.ready ? (
+				<p className="area-empty">Reading the ledger…</p>
+			) : (
+				<ol className="area-rows" aria-label="areas with open tickets">
+					{rows.map((r) => (
+						<li key={r.area}>
+							<button
+								type="button"
+								className="areas-row"
+								ref={(el) => {
+									if (el === null) refs.current.delete(r.area);
+									else refs.current.set(r.area, el);
+								}}
+								tabIndex={r.area === current ? 0 : -1}
+								aria-current={r.area === current}
+								aria-pressed={r.area === sent}
+								onFocus={() => setAt(r.area)}
+								onClick={() => pick(r.area)}
+							>
+								<span className="areas-name">{areaWords(r.area)}</span>
+								<span className="area-count">{r.count}</span>
+								<span className="areas-folders">
+									{r.folders.length === 0 ? "no pull request, no guess" : r.folders.join(", ")}
+								</span>
+								{r.area === sent ? <span className="areas-sent">shown</span> : null}
+							</button>
+						</li>
+					))}
+				</ol>
+			)}
+			{quiet.length === 0 ? null : (
+				<p className="areas-quiet">
+					No open tickets: {quiet.map((r) => areaWords(r.area)).join(", ")}
+				</p>
+			)}
+			<footer className="area-keys">
+				<span>
+					<Kbd>j</Kbd> <Kbd>k</Kbd> move
+				</span>
+				<span>
+					<Kbd>Enter</Kbd> show its tickets
+				</span>
+			</footer>
+		</section>
+	);
+}
