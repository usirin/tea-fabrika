@@ -0,0 +1,84 @@
+import {run} from "@demlik/tea/effect";
+import {defineProgram, end, input, output} from "@kampus/fabrika-old";
+import {FOLDERS} from "@kampus/pipeline/tickets/area";
+import {
+	AreaFilter,
+	fitsArea,
+	placedOfTicket,
+	type Tracker,
+	tickets,
+	ticketsKind,
+	ticketsOptions,
+} from "@tea-fabrika/tracker";
+import {Effect, Schema} from "effect";
+
+// A design sketch (a local branch, not for merge): the areas program, design B2 of the
+// area study. One job: the list of areas, each with its open tickets and its folders. A press
+// sends the area on; the tracker after it shows that area's tickets.
+//
+//   tsh> areas | tracker | ticket
+//   query {area: "pipeline"}   sends "pipeline" on `area`; the tracker shows pipeline's open tickets
+//
+// It reads the tickets with the tracker's own machine, as the ticket program does today
+// (program guidelines, G6: today's programs still import the tracker).
+
+/** One area on the list: how many open tickets it has, and the folders that make it. */
+export const AreaRow = Schema.Struct({
+	area: AreaFilter,
+	count: Schema.Int,
+	folders: Schema.Array(Schema.String),
+});
+export type AreaRow = typeof AreaRow.Type;
+
+export const Shown = Schema.Struct({ready: Schema.Boolean, rows: Schema.Array(AreaRow)});
+export type Shown = typeof Shown.Type;
+
+/** The view: every area in `FOLDERS` order, then the tickets nothing places yet. */
+export const shownOf = (s: Tracker): Shown => {
+	const open = s.tickets.filter((t) => t.state === "open").map(placedOfTicket);
+	return {
+		ready: s.ready,
+		rows: AreaFilter.literals.map((area) => ({
+			area,
+			count: open.filter((p) => fitsArea(area, p)).length,
+			folders: area === "none" ? [] : (FOLDERS.find((f) => f.area === area)?.paths ?? []),
+		})),
+	};
+};
+
+export const areas = defineProgram({
+	name: "areas",
+	description:
+		"A design sketch: the areas, each with its open tickets and its folders, worked out from the code. Sends the area a person picks, so `areas | tracker` shows its tickets. It has a window.",
+	inputs: {
+		query: input(
+			Schema.Struct({area: AreaFilter}),
+			'Pick an area: {area: "pipeline"} sends it on. Writes nothing.',
+			{writes: false},
+		),
+		quit: input(Schema.Null, "Stop."),
+	},
+	outputs: {
+		area: output(AreaFilter, "The area the person picks: sent each time the pick changes."),
+	},
+	machines: {tickets: ticketsKind},
+	view: {machine: "tickets", data: Shown, of: shownOf},
+	main: ({serve, send, watch}) =>
+		Effect.gen(function* () {
+			const runtime = yield* (yield* run(tickets, ticketsOptions)).ready;
+			yield* watch("tickets", "tickets", runtime);
+			let last: AreaFilter | null = null;
+			yield* serve({
+				query: (q) =>
+					Effect.gen(function* () {
+						if (q.area === last) return;
+						last = q.area;
+						// Down a pipe whose reader has gone, this send fails and areas ends.
+						yield* send("area", q.area);
+					}),
+				quit: () => end,
+			});
+			yield* runtime.dispatch({type: "quit"}).pipe(Effect.orDie);
+			yield* runtime.done();
+		}).pipe(Effect.scoped),
+});
