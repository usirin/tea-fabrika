{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"includes": [
			"**",
			// Recorded answers and toy projects: tests compare them byte for byte.
			"!**/fixtures",
			// Saved answers of experiments, written by their scripts.
			"!**/experiments/results",
			// Finished pieces about earlier stages. Left as they are.
			"!blog",
			"!video",
			// The custom rules themselves: a `.grit` file is not something biome formats.
			"!biome-plugins"
		]
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100,
		"indentStyle": "tab"
	},
	// Custom rules, copied from the pipeline this repo rebuilds, and the one of this repo's own
	// (no-bare-tell). A rule's level is set in its own file: "warn" and "error" block, "info"
	// only advises (no-effect-promise, no-raw-try-catch). See biome-plugins/README.md.
	"plugins": [
		"./biome-plugins/no-bare-tell.grit",
		"./biome-plugins/no-type-assertions.grit",
		"./biome-plugins/no-effect-promise.grit",
		"./biome-plugins/no-context-tag.grit",
		"./biome-plugins/no-data-taggederror.grit",
		"./biome-plugins/no-raw-try-catch.grit",
		"./biome-plugins/no-numeric-duration.grit",
		"./biome-plugins/no-throw-in-effect-gen.grit",
		"./biome-plugins/no-implicit-effect-concurrency.grit"
	],
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				// Node runs the .ts files as they are, so a relative import names its file whole.
				"useImportExtensions": "error"
			},
			"style": {
				// A gate: `pnpm lint` runs biome with `--error-on-warnings`, so this "warn" fails it
				// like an "error" does, and so does `noTsIgnore` below. `x!` throws away the
				// compiler's proof.
				"noNonNullAssertion": "warn"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noTsIgnore": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"bracketSpacing": false
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		}
	},
	"overrides": [
		{
			// Where a Claude run's settings come from is said by `ownRules` alone, so its file is left
			// out (experiment 155). So are tests: they write the options' shape to check it, and none
			// starts a live run. See biome-plugins/README.md.
			"includes": ["**", "!packages/fabrika/src/agents/claude/rules.ts", "!**/*.test.ts"],
			"plugins": ["./biome-plugins/no-project-settings.grit"]
		},
		{
			// A secret is read as a `Redacted`, never as a plain string from `process.env`
			// (docs/direction/secrets-are-redacted.md). Experiments are left out: they are outside
			// this rule's first change, and biome-plugins/README.md counts what it would find there.
			"includes": ["**", "!experiments/**"],
			"plugins": ["./biome-plugins/no-secret-env.grit"]
		},
		{
			// `Redacted.value` only where a secret goes out. Each file left out, and why:
			"includes": [
				"**",
				// the bearer token as a WebSocket subprotocol: a browser socket sends no header
				"!packages/fabrika/src/host/http.ts",
				// the door's secret in the ledger child's env, and in its locker file (mode 0600)
				"!packages/fabrika/src/host/local.ts",
				// the Worker's bindings: a one-way hash of the local secret, and GitHub's token
				"!packages/fabrika/src/host/worker-options.ts",
				// a token's one-way hash, the only form the ledger keeps
				"!packages/fabrika/src/host/door.ts",
				// a login's answer on the wire: the token goes to the one who logged in
				"!packages/fabrika/src/host/durable-object.ts",
				// an SSH key file's text, handed to sshsig.ts's parser (which may import nothing, so it
				// takes a string) and kept from then on as a WebCrypto key that cannot be exported
				"!packages/fabrika/src/host/signer.ts",
				// Jev's authorization header (the old factory)
				"!legacy/src/local.ts",
				// tests hold made-up secrets and read them back to check them
				"!**/*.test.ts",
				// outside this rule's first change, counted in biome-plugins/README.md
				"!experiments/**"
			],
			"plugins": ["./biome-plugins/no-redacted-value.grit"]
		},
		{
			"includes": ["**/*.test.ts"],
			// Test files only: an `expect` that sits only inside an `if` may never run.
			"plugins": ["./biome-plugins/no-expect-in-if.grit"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		}
	]
}
