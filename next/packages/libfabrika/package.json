{
  "name": "@kampus/libfabrika",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The new fabrika's library: its transport's SSHSIG (Tier 1, P7), its data layer, the ledger (P6), its coordination: the mailbox, starts and who belongs (P9), and its app layer: programs and the runner (P11).",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./coordination": "./src/coordination/index.ts",
    "./data": "./src/data/index.ts",
    "./door": "./src/gateway/index.ts",
    "./sqlite": "./src/ledger/NodeSqlite.ts",
    "./box": "./src/cloudflare/box.ts",
    "./build": "./src/node/build/build.ts",
    "./build-modules": "./src/node/build/build-modules.d.ts",
    "./compiler": "./src/node/build/compiler.ts",
    "./workers": "./src/cloudflare/index.ts",
    "./workers/bindings": "./src/cloudflare/bindings.ts",
    "./workers/control": "./src/cloudflare/control.ts",
    "./workers/gateway": "./src/cloudflare/connection.ts",
    "./workers/record": "./src/cloudflare/record.ts",
    "./workers/runtime": "./src/cloudflare/runtime.ts",
    "./node/build": "./src/node/build/bundle.ts",
    "./node/local-stage": "./src/node/dev/local-dev.ts",
    "./node/stage": "./src/node/dev/dev.ts",
    "./node/stage-recording": "./src/node/dev/dev-recording.ts",
    "./brain-life": "./src/runtime/BrainLife.ts",
    "./brain-event": "./src/runtime/BrainEvent.ts",
    "./testing": "./src/Testing.ts",
    "./transport": "./src/transport/index.ts",
    "./transport/gateway": "./src/transport/Connection.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.84",
    "@demlik/tea": "catalog:",
    "effect": "catalog:",
    "lightningcss": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform-react": "catalog:",
    "rolldown": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
