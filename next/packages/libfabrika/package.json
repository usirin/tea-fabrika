{
	"name": "@kampus/libfabrika",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The new fabrika's library: its transport's SSHSIG (Tier 1, P7), its data layer, the ledger (P6), its coordination: the mailbox, starts and who belongs (P9), and its app layer: programs and the runner (P11).",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts",
		"./coordination": "./src/coordination/index.ts",
		"./data": "./src/data/index.ts",
		"./desktop": "./src/desktop/index.ts",
		"./electron": "./src/electron/index.ts",
		"./electron/preload": "./src/electron/preload.ts",
		"./node/desktop-store": "./src/node/desktop-store.ts",
		"./node/launchd": "./src/node/launchd.ts",
		"./sqlite": "./src/data/sqlite.ts",
		"./testing": "./src/testing.ts",
		"./transport": "./src/transport/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/vitest": "catalog:",
		"@types/node": "catalog:",
		"electron": "catalog:",
		"fast-check": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
