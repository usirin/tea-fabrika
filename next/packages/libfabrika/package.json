  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "alchemy": "catalog:",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@demlik/tea": "catalog:",
    "effect": "catalog:",
    "lightningcss": "catalog:",
    "oxc-parser": "catalog:",
    "oxc-transform-react": "catalog:",
    "rolldown": "catalog:",
    "toml-eslint-parser": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "react": "catalog:",
