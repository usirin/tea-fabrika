    "./transport/internal/*": null,
    "./telemetry/*": "./src/telemetry/*.ts",
    "./telemetry/internal/*": null,
    "./ledger/*": "./src/ledger/*.ts",
    "./ledger/internal/*": null,
    "./processes/*": "./src/processes/*.ts",
    "./processes/internal/*": null,
    "./presence/*": "./src/presence/*.ts",
    "./presence/internal/*": null,
    "./jobs/*": "./src/jobs/*.ts",
    "./jobs/internal/*": null,
    "./packs/*": "./src/packs/*.ts",
    "./packs/internal/*": null,
    "./access/*": "./src/access/*.ts",
    "./access/internal/*": null,
    "./email": "./src/email/index.ts",
    "./email/*": "./src/email/*.ts",
    "./email/internal/*": null,
    "./runtime/*": "./src/runtime/*.ts",
    "./runtime/internal/*": null,
    "./gateway/*": "./src/gateway/*.ts",
    "./gateway/internal/*": null,
    "./settings/*": "./src/settings/*.ts",
    "./settings/internal/*": null,
    "./node/settings/*": "./src/node/settings/*.ts",
    "./coordination": "./src/coordination/index.ts",
    "./sqlite": "./src/ledger/NodeSqlite.ts",
    "./box": "./src/cloudflare/box.ts",
    "./build": "./src/node/build/build.ts",
    "./build-modules": "./src/node/build/build-modules.d.ts",
    "./compiler": "./src/node/build/compiler.ts",
    "./workers": "./src/cloudflare/index.ts",
    "./workers/bindings": "./src/cloudflare/bindings.ts",
    "./workers/control": "./src/cloudflare/control.ts",
    "./workers/gateway": "./src/cloudflare/connection.ts",
    "./workers/objects": "./src/cloudflare/objects.ts",
    "./workers/record": "./src/cloudflare/record.ts",
    "./workers/runtime": "./src/cloudflare/runtime.ts",
    "./node/build": "./src/node/build/bundle.ts",
    "./node/local-dev": "./src/node/dev/local-dev.ts",
    "./node/dev": "./src/node/dev/dev.ts",
    "./node/dev-recording": "./src/node/dev/dev-recording.ts",
    "./brain-life": "./src/runtime/BrainLife.ts",
    "./brain-event": "./src/runtime/BrainEvent.ts",
    "./testing": "./src/Testing.ts"
