{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "desktop": {
      "type": "object",
      "properties": {
        "brain-poll": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The interval in milliseconds between brain readiness and shutdown checks.",
          "default": 100
        },
        "brain-start-timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The maximum time in milliseconds to start or reuse a ready local brain.",
          "default": 60000
        },
        "brain-stop-timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The maximum time in milliseconds to confirm the local brain and its children have stopped.",
          "default": 5000
        },
        "brain-throttle": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The delay in whole seconds between crash restarts of the local brain.",
          "default": 2
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The most routed attempts one signed-in key may make in one gateway window.",
          "default": 600
        },
        "window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "The gateway window in milliseconds.",
          "default": 60000
        }
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "title": "a port",
          "description": "The port the local instance listens on.",
          "default": 18787
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {}
}
