{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // `src/entry/*.tsx` is React in a browser tab; the rest is the Worker and Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The package commands use plain Node, which strips types without transforming them.
    "erasableSyntaxOnly": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
