{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@cloudflare/workers-types"],
    // `src/entry/*.tsx` is React in a browser tab; the rest is the Worker and Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // The package commands use plain Node, which strips types without transforming them.
    "erasableSyntaxOnly": true
  },
  // The P19 host check bundles this fixture as the small brain that exits normally, so it is checked
  // here with the code that runs it. The root tsconfig is for editors only and no typecheck reads it.
  "include": ["**/*.ts", "**/*.tsx", "../../../fixtures/next/p19-launchd/brain.ts"]
}
