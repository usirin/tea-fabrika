		"@kampus/pipeline": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
