    },
    {
      "kind": "example",
      "id": "dashes",
      "rule": "Spaces become single dashes",
      "file": "slugify.js",
      "name": "slugify",
      "examples": [{ "call": "slugify(\"hello   big world\")", "result": "\"hello-big-world\"" }]
    },
    {
      "kind": "example",
      "id": "ascii",
      "rule": "Characters outside a-z and 0-9 are dropped",
      "file": "slugify.js",
      "name": "slugify",
      "examples": [{ "call": "slugify(\"héllo, wörld 42!\")", "result": "\"hllo-wrld-42\"" }]
    }
  ]
