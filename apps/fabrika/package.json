{
	"name": "@kampus/fabrika-app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The fabrika app: a terminal window running tsh, and a window of its own for each run of a program that has one. A walking skeleton.",
	"main": "dist/main.mjs",
	"scripts": {
		"build": "node build.ts",
		"start": "node build.ts && electron .",
		"e2e": "node build.ts && node e2e.ts",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@demlik/tea": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/fabrika": "workspace:*",
		"@tea-fabrika/counter": "workspace:*",
		"@tea-fabrika/tracker": "workspace:*",
		"effect": "catalog:",
		"ghostty-web": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"electron": "catalog:",
		"esbuild": "catalog:",
		"playwright": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
