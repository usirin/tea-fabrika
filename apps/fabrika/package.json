{
	"name": "@kampus/fabrika-app-old",
	"productName": "@kampus/fabrika-app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "The fabrika app: one window, tiled like tmux, where every tile runs its own tsh and a program with a view runs inside a tile. A walking skeleton.",
	"main": "dist/main.mjs",
	"scripts": {
		"build": "node build.ts",
		"start": "node build.ts && electron .",
		"e2e": "node build.ts && node e2e.ts",
		"e2e:lane": "node build.ts && node lane-e2e.ts",
		"shots": "node build.ts && node shots.ts",
		"table": "node table.ts",
		"cli": "node src/cli.ts",
		"typecheck": "tsc --noEmit -p ."
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "catalog:",
		"@anthropic-ai/sandbox-runtime": "catalog:",
		"@demlik/tea": "catalog:",
		"@effect/platform-node": "catalog:",
		"@kampus/fabrika-old": "workspace:*",
		"@kampus/pipeline": "workspace:*",
		"@manti-ui/react": "catalog:",
		"@manti-ui/styles": "catalog:",
		"@modelcontextprotocol/server": "catalog:",
		"@stryker-mutator/core": "catalog:",
		"@stryker-mutator/instrumenter": "catalog:",
		"@stryker-mutator/vitest-runner": "catalog:",
		"@tea-fabrika/compare": "workspace:*",
		"@tea-fabrika/counter": "workspace:*",
		"@tea-fabrika/experiment": "workspace:*",
		"@tea-fabrika/experiments": "workspace:*",
		"@tea-fabrika/map": "workspace:*",
		"@tea-fabrika/markdown": "workspace:*",
		"@tea-fabrika/pipeline": "workspace:*",
		"@tea-fabrika/runs": "workspace:*",
		"@tea-fabrika/ticket": "workspace:*",
		"@tea-fabrika/trace": "workspace:*",
		"@tea-fabrika/tracker": "workspace:*",
		"@xyflow/react": "catalog:",
		"effect": "catalog:",
		"ghostty-web": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
