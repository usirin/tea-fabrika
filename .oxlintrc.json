      "files": [".agents/**/*.ts", ".agents/**/*.mjs"],
      "rules": {
        "fabrika/no-promises": "error",
        "fabrika/no-ledger-sql": "error",
        "fabrika/no-node-filesystem": "error",
        "fabrika/no-node-imports": "error",
        "fabrika/no-effect-run-outside-edge": "error",
        "fabrika/edge-comment": "error",
        "fabrika/effect-functions": "error",
        "fabrika/no-of": "error",
        "fabrika/no-why-key": "error",
        "fabrika/no-hand-tag": "error",
        "fabrika/one-store-hook": "error",
        "fabrika/no-stage-word": "error"
