  "overrides": [
    {
      // L5 plant: import homedir or a filesystem namespace to inspect inherited homes.
      "files": ["scripts/vitest.setup.ts", "scripts/testhome.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:os",
                "importNames": ["homedir"]
              },
              {
                "name": "os",
                "importNames": ["homedir"]
              },
              {
                "name": "node:fs",
                "importNames": ["lstat", "lstatSync", "realpath", "realpathSync", "readlink", "readlinkSync"]
              },
              {
                "name": "fs",
                "importNames": ["lstat", "lstatSync", "realpath", "realpathSync", "readlink", "readlinkSync"]
              },
              {
                "name": "node:fs/promises",
                "importNames": ["lstat", "realpath", "readlink"]
              },
              {
                "name": "fs/promises",
                "importNames": ["lstat", "realpath", "readlink"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/fabrika/src/host/settings.laws.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@effect/platform-node",
                  "@effect/platform-node/*",
                  "node:fs",
                  "node:fs/*",
                  "@radix-ui/colors",
                  "@radix-ui/colors/*"
                ],
                "message": "L8: settings laws use an in-memory FileSystem, never a real file system. Radix tokens remain restricted."
              }
            ]
          }
        ]
      }
    },
    {
      // Test files only: an `expect` that sits only inside an `if` may never run.
      // `!` is allowed here: a test that hits a missing value fails on its own.
      "files": ["**/*.test.ts"],
      "rules": {
        "fabrika/no-expect-in-if": "error",
        "typescript/no-non-null-assertion": "off",
        // Tests hold made-up secrets and read them back to check them.
        "fabrika/no-redacted-value": "off",
        // Tests write the options' shape to check it, and none starts a live run.
        "fabrika/no-project-settings": "off"
      }
    },
    {
      // In `packages/` and `experiments/`, a `.ts` file's `use` or `useKey` is Effect's or vitest's,
      // not a hook: 19 of 19 fires there were false alarms. So hooks are checked in every window
      // file, and in `.ts` only where windows live.
      "files": ["**/*.tsx", "apps/**/*.ts", "programs/**/*.ts"],
      "rules": { "react/rules-of-hooks": "error" }
    },
    {
      // There is no JSX in a .ts file: its one `children` prop is what `createElement`'s types ask.
      "files": ["**/*.tsx"],
      "rules": { "react/no-children-prop": "error" }
    },
    {
      // The token build reads Radix's steps and writes them out as tokens (design foundations, PR 2).
      "files": ["packages/fabrika-design/src/build/**"],
      "rules": { "eslint/no-restricted-imports": "off" }
    },
    {
      // `ownRules` is the one place that says where a Claude run's settings come from.
      "files": ["packages/fabrika/src/agents/claude/rules.ts"],
      "rules": { "fabrika/no-project-settings": "off" }
    },
    {
      // no-secret-env and no-redacted-value are outside experiments, as they were under Biome:
      // those two rules' first change left them out, and the README counts what they would find.
      "files": ["experiments/**"],
      "rules": { "fabrika/no-secret-env": "off", "fabrika/no-redacted-value": "off" }
    },
    {
      // The bearer token as a WebSocket subprotocol: a browser socket sends no header.
      "files": ["packages/fabrika/src/host/http.ts"],
      "rules": { "fabrika/no-redacted-value": "off" }
    },
    {
      // The door's secret in the ledger child's env, and in its locker file (mode 0600).
      "files": ["packages/fabrika/src/host/local.ts"],
      "rules": { "fabrika/no-redacted-value": "off" }
    },
    {
      // The Worker's bindings: a one-way hash of the local secret, and GitHub's token.
      "files": ["packages/fabrika/src/host/worker-options.ts"],
      "rules": { "fabrika/no-redacted-value": "off" }
    },
    {
