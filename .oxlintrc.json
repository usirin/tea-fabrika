// The lint settings. `pnpm lint` runs them through oxlint-plugins/lint.ts, which fails on any
// diagnostic but the advice rules. docs/direction/oxlint-and-oxfmt.md says what each choice costs.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "vitest", "import", "promise"],
  // Custom rules, copied from the pipeline this repo rebuilds, and this repo's own. See
  // oxlint-plugins/README.md.
  "jsPlugins": ["./oxlint-plugins/index.ts"],
  // Each rule is named here, so a new oxlint release adds none on its own.
  "categories": { "correctness": "off" },
  "options": { "reportUnusedDisableDirectives": "error" },
  // `.claude/skills/*` are symlinks into `.agents/skills/`: walked there too, a file of `.agents/` is
  // read a second time outside its override, where an edge comment looks unused and fails.
  "ignorePatterns": [
    "**/fixtures/**",
    "**/experiments/results/**",
    "unreachable-ledger.json",
    "agents-ledger.json",
    ".claude/**"
  ],
  "rules": {
    // "warn" here only advises: lint.ts prints these two and does not fail on them. They were
    // wrong too often to block (experiment 125). Any other warning fails.
    "fabrika/no-effect-promise": "warn",
    "fabrika/no-raw-try-catch": "warn",

    "fabrika/no-bare-tell": "error",
    "fabrika/no-context-tag": "error",
    "fabrika/no-data-taggederror": "error",
    "fabrika/no-implicit-effect-concurrency": "error",
    "fabrika/no-numeric-duration": "error",
    "fabrika/no-throw-in-effect-gen": "error",
    "fabrika/no-type-assertions": "error",
    // P16: the package keeps its pure entry; a real window is always './window'.
    "fabrika/program-package-layout": "error",
    // P17a counted before enabling: 53 retired-door statements, 1 throwing saved decoder.
    // All inspected: app door code moves; runner's saved Cmd decode needs a typed result.
    "fabrika/door-is-library": "error",
    // T518 A8: the only current match is P17a's second module, confirmed by hand.
    "fabrika/one-id-module": "error",
    "fabrika/outside-input-constructor": "error",

    // Where a Claude run's settings come from is said by `ownRules` alone, so its file is left
    // out below (experiment 155). So are tests: they write the options' shape to check it, and
    // none starts a live run.
    "fabrika/no-project-settings": "error",
    // A secret is read as a `Redacted`, never as a plain string from `process.env`
    // (docs/direction/secrets-are-redacted.md). Experiments are left out below: they are outside
    // this rule's first change, and README counts what it would find there.
    "fabrika/no-secret-env": "error",
    // `Redacted.value` only where a secret goes out. Each file left out below says why.
    "fabrika/no-redacted-value": "error",

    // Node runs the .ts files as they are, so a relative import names its file whole.
    "fabrika/use-import-extensions": "error",

    // An ignore comment names its rules and says why. It blocks, and an ignore comment cannot
    // silence it.
    "fabrika/no-bare-disable": "error",

    // A blank line between top-level statements and between class members (owner, 2026-11-09;
    // docs/direction/oxlint-and-oxfmt.md). `pnpm format` adds them.
    "fabrika/padding-line-between-statements": "error",

    // Braces on every if, else, for, while and do, even on one line (owner, 2026-11-09).
    "eslint/curly": ["error", "all"],
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-fallthrough": ["error", { "allowEmptyCase": true }],
    "eslint/no-labels": ["error", { "allowLoop": true, "allowSwitch": true }],
    "eslint/no-unused-vars": [
      "error",
      {
        "args": "all",
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "eslint/no-use-before-define": [
      "error",
      {
        "functions": false,
        "classes": false,
        "variables": false,
        "enums": false,
        "typedefs": false,
        "ignoreTypeReferences": true
      }
    ],
    "eslint/prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
    "typescript/ban-ts-comment": [
      "error",
      { "ts-ignore": true, "ts-expect-error": false, "ts-nocheck": false, "ts-check": false }
    ],
    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    "typescript/no-empty-object-type": "error",

    // `x!` throws away the compiler's proof.
    "typescript/no-non-null-assertion": "error",

    // Code never reaches a primitive (design language, call 3): it reads a token. Only the token
    // build imports Radix, so it is turned off for that folder alone below.
    "eslint/no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@radix-ui/colors",
            "message": "Code never reaches a primitive: read a token. Only packages/fabrika-design/src/build/ imports Radix."
          }
        ],
        "patterns": [
          {
            "group": ["@radix-ui/colors/*"],
            "message": "Code never reaches a primitive: read a token. Only packages/fabrika-design/src/build/ imports Radix."
          }
        ]
      }
    ],

